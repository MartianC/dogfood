.recipe-card {
  display: flex;
  height: 180rpx;
  padding: 0;
  border: 1rpx solid #d8e1da;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(20, 37, 28, 0.06);
  overflow: hidden;
}

.thumb {
  width: 240rpx;
  height: 180rpx;
  flex: 0 0 240rpx;
  background: #edf4ee;
  border-right: 1rpx solid #d8e1da;
  overflow: hidden;
}

.thumb-image {
  width: 100%;
  height: 100%;
  display: block;
}

.body {
  min-width: 0;
  flex: 1;
  padding: 18rpx 22rpx 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.title-row {
  min-width: 0;
}

.name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 800;
  color: #17201b;
}

.fit {
  background: #edf4ee;
  color: #34423a;
}

.fit.ok {
  background: #e3f0e8;
  color: #25684a;
}

.fit.warning,
.fit.danger {
  background: #f6e8e1;
  color: #a84f34;
}

.desc,
.ingredients {
  margin-top: 7rpx;
  color: #6f7b73;
  line-height: 1.35;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  max-height: 38rpx;
  overflow: hidden;
}

.tag {
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #edf4ee;
  color: #34423a;
  font-size: 20rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.tag.good {
  background: #e3f0e8;
  color: #25684a;
}
