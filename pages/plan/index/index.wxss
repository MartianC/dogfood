.plan-hero {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #25684a;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(20, 37, 28, 0.09);
}

.plan-hero .eyebrow {
  color: rgba(255, 255, 255, 0.78);
}

.plan-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 800;
}

.plan-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.45;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf4ee;
  line-height: 1.45;
}

.summary-row:last-child {
  border-bottom: 0;
}

.step-row {
  justify-content: flex-start;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 14rpx;
  background: #e3f0e8;
  color: #25684a;
  text-align: center;
  line-height: 44rpx;
  font-weight: 800;
}

.share-canvas {
  width: 320px;
  height: 420px;
  position: fixed;
  left: -9999px;
  top: -9999px;
}
