@import "../../../styles/tokens.wxss";

.advice-eyebrow {
  color: var(--df-color-primary);
  font-weight: 700;
}

.advice-title {
  margin-top: 12rpx;
}

.advice-subtitle {
  margin-top: 16rpx;
  color: var(--df-color-muted);
}

.meter {
  height: 12rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: var(--df-color-surface-muted);
  overflow: hidden;
}

.meter view {
  width: 72%;
  height: 100%;
  border-radius: 999rpx;
  background: var(--df-color-primary);
}
