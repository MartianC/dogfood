@import "../../../styles/tokens.wxss";

.dog-profile-page {
  padding-top: 0;
}

.dog-profile-section {
  margin-top: 0;
}

.dog-profile-form {
  display: grid;
  gap: var(--df-space-3);
}

.dog-profile-avatar {
  width: 112rpx;
  min-height: var(--df-touch-min);
  margin: 0 auto;
  padding: var(--df-space-1) 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dog-profile-avatar__image {
  width: 104rpx;
  height: 104rpx;
  display: block;
  border: 1rpx solid var(--df-color-line-strong);
  border-radius: var(--df-radius-xl);
  background: var(--df-color-surface-muted);
}

.dog-profile-pair {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--df-space-3);
}

.dog-profile-control,
.dog-profile-picker-value,
.dog-profile-readonly {
  min-height: 58rpx;
  font-size: var(--df-font-md);
  line-height: 58rpx;
}

.dog-profile-picker-value--empty,
.dog-profile-readonly--muted {
  color: var(--df-color-muted);
}

.dog-profile-activity-feedback {
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  font-weight: 700;
  line-height: 40rpx;
}

.dog-profile-activity-slider {
  position: relative;
  height: var(--df-touch-min);
  margin-top: var(--df-space-1);
}

.dog-profile-activity-slider__bands {
  position: absolute;
  top: 38rpx;
  right: 0;
  left: 0;
  height: 12rpx;
  display: flex;
  overflow: hidden;
  border-radius: var(--df-radius-pill);
}

.dog-profile-activity-slider__band {
  background: var(--df-color-primary);
}

.dog-profile-activity-slider__band--low,
.dog-profile-activity-slider__band--general,
.dog-profile-activity-slider__band--active {
  flex: 1;
}

.dog-profile-activity-slider__band--high {
  flex: 3;
}

.dog-profile-activity-slider__band--low {
  opacity: 0.18;
}

.dog-profile-activity-slider__band--general {
  opacity: 0.36;
}

.dog-profile-activity-slider__band--active {
  opacity: 0.62;
}

.dog-profile-activity-slider__band--high {
  opacity: 1;
}

.dog-profile-activity-slider__thumb {
  position: absolute;
  z-index: 1;
  top: 26rpx;
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  border: 6rpx solid var(--df-color-surface);
  border-radius: var(--df-radius-pill);
  background: var(--df-color-primary);
  box-shadow: var(--df-shadow-card);
  transform: translateX(-50%);
}

.dog-profile-activity-slider__input {
  position: absolute;
  z-index: 2;
  inset: 0;
  width: 100%;
  height: var(--df-touch-min);
  margin: 0;
  opacity: 0.01;
}

.dog-profile-choices {
  display: flex;
  flex-wrap: wrap;
  gap: var(--df-space-2);
}

.dog-profile-choice {
  min-width: 112rpx;
  min-height: var(--df-touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dog-profile-delete-action {
  margin-top: var(--df-space-5);
}
