@import "../../styles/tokens.wxss";

.selector-head {
  display: flex;
  justify-content: space-between;
  font-weight: 800;
}

.selector-all {
  color: var(--df-color-primary);
  font-weight: 600;
}

.selector-chips {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
}

.selector-chip {
  min-height: 88rpx;
  padding: 12rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: 20rpx;
  background: var(--df-color-surface);
  color: var(--df-color-text-secondary);
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 14rpx;
  align-items: center;
}

.selector-chip--active {
  border-color: var(--df-color-line-strong);
  background: var(--df-color-primary-soft);
  color: var(--df-color-primary);
}

.selector-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--df-color-surface-muted);
}

.selector-dog-copy {
  min-width: 0;
}

.selector-dog-name {
  font-size: 26rpx;
  font-weight: 800;
}

.selector-dog-meta {
  margin-top: 4rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
}
