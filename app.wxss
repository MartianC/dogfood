@import "./styles/tokens.wxss";
@import "./styles/typography.wxss";
@import "./styles/utilities.wxss";

page {
  min-height: 100vh;
  background: var(--df-color-bg);
  color: var(--df-color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 48rpx;
}

.page.with-bottom-action {
  padding-bottom: calc(176rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 32rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: 24rpx;
  background: var(--df-color-surface);
  box-shadow: var(--df-shadow-hero);
}

.eyebrow {
  color: var(--df-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--df-color-text);
}

.subtitle {
  margin-top: 16rpx;
  color: var(--df-color-muted);
  line-height: 1.55;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
}

.link {
  color: var(--df-color-primary);
  font-size: 26rpx;
}

.card {
  border: 1rpx solid var(--df-color-line);
  border-radius: 20rpx;
  background: var(--df-color-surface);
  box-shadow: var(--df-shadow-card);
  padding: 24rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: var(--df-color-muted);
}

.tiny {
  font-size: 24rpx;
  color: var(--df-color-muted);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--df-color-surface-muted);
  color: var(--df-color-text-secondary);
  font-size: 23rpx;
}

.tag.good {
  background: var(--df-color-primary-soft);
  color: var(--df-color-primary);
}

.tag.warning {
  background: var(--df-color-warning-soft);
  color: var(--df-color-warning);
}

.button-row {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: var(--df-color-primary);
  color: var(--df-color-on-primary);
  font-weight: 800;
  font-size: 30rpx;
  border: 1rpx solid var(--df-color-primary);
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.button::after {
  border: 0;
}

.button.secondary {
  background: var(--df-color-surface);
  color: var(--df-color-text-secondary);
  border-color: var(--df-color-line-strong);
}

.button.warning {
  background: var(--df-color-warning);
  border-color: var(--df-color-warning);
}

.bottom-action {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(28rpx + constant(safe-area-inset-bottom));
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  gap: 16rpx;
  z-index: 20;
}

.notice {
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: var(--df-color-surface-muted);
  color: var(--df-color-text-secondary);
  line-height: 1.5;
}

.notice.good {
  background: var(--df-color-primary-soft);
  color: var(--df-color-primary);
}

.notice.warning {
  background: var(--df-color-warning-soft);
  color: var(--df-color-warning);
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--df-color-line);
}

.field label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--df-color-muted);
  font-size: 24rpx;
}

.input,
.picker-value {
  min-height: 64rpx;
  color: var(--df-color-text);
  font-size: 30rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.metric {
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--df-color-surface-muted);
}

.metric strong {
  display: block;
  font-size: 34rpx;
  color: var(--df-color-text);
}

.metric span {
  display: block;
  margin-top: 6rpx;
  color: var(--df-color-muted);
  font-size: 24rpx;
}
