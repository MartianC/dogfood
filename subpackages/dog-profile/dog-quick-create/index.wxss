@import "../../../styles/tokens.wxss";

.form-eyebrow {
  color: var(--df-color-primary);
  font-weight: 700;
}

.form-title {
  margin-top: 12rpx;
}

.form-subtitle {
  margin-top: 16rpx;
  color: var(--df-color-muted);
}

.profile-form {
  display: grid;
  gap: 16rpx;
}

.avatar-picker {
  display: grid;
  grid-template-columns: 108rpx 1fr;
  gap: 20rpx;
  align-items: center;
}

.avatar-preview {
  width: 108rpx;
  height: 108rpx;
  border: 1rpx solid var(--df-color-line-strong);
  border-radius: 28rpx;
  background: var(--df-color-surface-muted);
  display: block;
}

.avatar-title {
  color: var(--df-color-text);
  font-size: 28rpx;
  font-weight: 800;
}

.avatar-desc {
  margin-top: 8rpx;
  color: var(--df-color-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.form-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.form-control,
.picker-value {
  min-height: 58rpx;
  line-height: 58rpx;
  font-size: 28rpx;
}

.target-panel {
  padding: 4rpx 0;
}

.panel-title {
  color: var(--df-color-text);
  font-size: 28rpx;
  font-weight: 800;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
