{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weightMeasurementStorage/v1",
  "title": "体重测量记录 CloudBase 存储 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_openid",
    "schemaVersion",
    "dogId",
    "weightKg",
    "measuredOn",
    "createdAt"
  ],
  "properties": {
    "_id": { "type": "string", "minLength": 1 },
    "_openid": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "dogId": { "type": "string", "minLength": 1 },
    "weightKg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.01
    },
    "measuredOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "createdAt": { "type": ["string", "object"] }
  }
}
