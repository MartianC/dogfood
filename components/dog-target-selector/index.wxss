.selector {
  padding: 24rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(20, 37, 28, 0.06);
}

.head {
  display: flex;
  justify-content: space-between;
  font-weight: 800;
}

.all {
  color: #25684a;
  font-weight: 600;
}

.chips {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chip {
  min-height: 88rpx;
  padding: 12rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 20rpx;
  background: #ffffff;
  color: #34423a;
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 14rpx;
  align-items: center;
}

.chip.active {
  border-color: rgba(37, 104, 74, 0.28);
  background: #e3f0e8;
  color: #25684a;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #edf4ee;
}

.dog-copy {
  min-width: 0;
}

.dog-name {
  font-size: 26rpx;
  font-weight: 800;
}

.dog-meta {
  margin-top: 4rpx;
  color: #6f7b73;
  font-size: 22rpx;
}
