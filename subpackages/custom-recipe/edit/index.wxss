@import "../../../styles/tokens.wxss";

.recipe-eyebrow {
  color: var(--df-color-primary);
  font-weight: 700;
}

.recipe-title {
  margin-top: 12rpx;
}

.recipe-subtitle {
  margin-top: 16rpx;
  color: var(--df-color-muted);
}

.recipe-control {
  min-height: 58rpx;
  line-height: 58rpx;
  font-size: 28rpx;
}

.recipe-actions {
  display: grid;
  gap: 16rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
