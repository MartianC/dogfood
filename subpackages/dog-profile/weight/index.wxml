<view class="page weight-page" aria-label="体重趋势">
  <view class="weight-page__heading">
    <view class="df-heading-lg">体重趋势</view>
    <view class="weight-page__description">记录每次实际测量，查看变化，不替代健康判断。</view>
  </view>

  <view wx:if="{{dogs.length > 1}}" class="weight-dog-switcher">
    <ui-field label="当前狗狗">
      <picker range="{{dogs}}" range-key="name" value="{{dogIndex}}" bindchange="onDogChange">
        <view class="weight-picker-value">{{dogName}}</view>
      </picker>
    </ui-field>
  </view>

  <block wx:if="{{loadStatus === 'loading'}}">
    <view class="weight-page__status" aria-live="polite">
      <view class="weight-page__status-title">正在读取{{dogName}}的体重记录</view>
      <view class="weight-page__status-description">完成后会显示当前体重、趋势和历史测量。</view>
    </view>
  </block>

  <block wx:elif="{{loadStatus === 'error'}}">
    <view class="weight-page__status">
      <ui-notice variant="warning">{{errorText}}</ui-notice>
      <view class="weight-page__status-action">
        <ui-button size="medium" bind:tap="onRetry">重新加载</ui-button>
      </view>
    </view>
  </block>

  <block wx:elif="{{loadStatus === 'empty'}}">
    <view class="weight-page__empty-dog">
      <ui-empty title="还没有狗狗档案" description="添加狗狗后，就可以记录每次实际称量。" actionText="添加狗狗" bind:action="onAddDog" />
    </view>
  </block>

  <block wx:elif="{{loadStatus === 'ready'}}">
    <view class="weight-section weight-current-section">
      <ui-card variant="primary" padding="large">
        <view class="weight-current">
          <view class="weight-current__eyebrow">{{dogName}} · 当前体重</view>
          <view class="weight-current__value">{{currentWeightText}}</view>
          <view class="weight-current__date">{{currentMeasuredOnText}}</view>
          <view class="weight-current__source">{{currentWeightSourceText}}</view>
        </view>
      </ui-card>
    </view>

    <view class="weight-section">
      <view class="weight-section__head">
        <view>
          <view class="weight-section__title">变化趋势</view>
          <view class="weight-section__description">{{recordCountText}} · 只显示有效测量</view>
        </view>
        <ui-button size="small" block="{{false}}" variant="ghost" bind:tap="onAddWeight">记录体重</ui-button>
      </view>

      <ui-card wx:if="{{hasMeasurements}}" padding="large">
        <view class="weight-chart-summary">
          <view class="weight-chart-summary__label">从 {{chartStartDateText}} 到 {{chartEndDateText}}</view>
          <view class="weight-chart-summary__range">{{chartMinLabel}} — {{chartMaxLabel}}</view>
        </view>
        <view
          class="weight-chart-layout"
          aria-label="体重变化折线图，纵轴从 {{chartAxisMinLabel}} 到 {{chartAxisMaxLabel}}"
        >
          <view class="weight-chart-y-axis" aria-hidden="true">
            <text class="weight-chart-y-axis__label">{{chartAxisMaxLabel}}</text>
            <text class="weight-chart-y-axis__label">{{chartAxisMiddleLabel}}</text>
            <text class="weight-chart-y-axis__label">{{chartAxisMinLabel}}</text>
          </view>
          <view class="weight-chart">
            <view class="weight-chart__grid weight-chart__grid--top" aria-hidden="true"></view>
            <view class="weight-chart__grid weight-chart__grid--middle" aria-hidden="true"></view>
            <view class="weight-chart__grid weight-chart__grid--bottom" aria-hidden="true"></view>
            <view
              wx:for="{{chartSegments}}"
              wx:key="id"
              class="weight-chart__segment"
              style="{{item.style}}"
              aria-hidden="true"
            ></view>
            <view
              wx:for="{{chartPoints}}"
              wx:key="id"
              class="weight-chart__point {{item.isLatest ? 'weight-chart__point--latest' : ''}}"
              style="{{item.style}}"
              aria-label="{{item.dateText}} {{item.weightText}}"
            >
              <view class="weight-chart__dot"></view>
            </view>
          </view>
        </view>
        <view class="weight-chart-axis" aria-hidden="true">
          <text>{{chartStartDateText}}</text>
          <text>{{chartEndDateText}}</text>
        </view>
      </ui-card>

      <ui-empty
        wx:else
        title="还没有体重测量"
        description="记录第一次体重后，这里会显示变化趋势和历史事实。"
        actionText="记录第一次体重"
        bind:action="onAddWeight"
      />
    </view>

    <view class="weight-section weight-history-section">
      <view class="weight-section__head">
        <view>
          <view class="weight-section__title">测量历史</view>
          <view class="weight-section__description">每次记录都保留，修改会生成新的替代记录。</view>
        </view>
      </view>

      <view wx:if="{{hasMeasurements}}" class="weight-history-list">
        <ui-card wx:for="{{historyItems}}" wx:key="id" padding="large">
          <view class="weight-history-item">
            <view class="weight-history-item__main">
              <view class="weight-history-item__heading">
                <text>{{item.weightText}}</text>
                <ui-tag wx:if="{{item.isLatest}}" variant="good" size="small">最新</ui-tag>
              </view>
              <view class="weight-history-item__date">{{item.measuredOnText}}</view>
              <view wx:if="{{item.changeText}}" class="weight-history-item__change">{{item.changeText}}</view>
            </view>
            <ui-button size="small" block="{{false}}" variant="secondary" data-id="{{item.id}}" bind:tap="onEditWeight">编辑</ui-button>
          </view>
        </ui-card>
      </view>

      <view wx:if="{{nextCursor}}" class="weight-history-more">
        <ui-button variant="secondary" loading="{{loadingMore}}" bind:tap="onLoadMore">加载更多</ui-button>
      </view>
    </view>
  </block>
</view>
