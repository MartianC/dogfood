<view class="page with-tab-bar recipe-library-page">
  <view class="recipe-library-intro">记录常做的搭配，随时调整食材和份量。</view>

  <view wx:if="{{recipes.length}}" class="recipe-library-list">
    <recipe-library-card
      wx:for="{{recipes}}"
      wx:key="id"
      recipe="{{item}}"
      bind:taprecipe="onRecipeTap"
    />
  </view>

  <view wx:else class="recipe-library-empty">
    <recipe-empty
      icon="add-circle"
      title="先建立第一份食谱"
      description="从常吃的食材开始，之后每次配餐都会更省心。"
      action-text="新建食谱"
      bind:action="openCreatePopup"
    />
  </view>

  <view wx:if="{{recipes.length}}" class="recipe-library-fab">
    <recipe-fab bind:tap="openCreatePopup" />
  </view>

  <recipe-create-popup
    id="recipeCreatePopup"
    visible="{{createVisible}}"
    dogs="{{dogs}}"
    loading="{{createLoading}}"
    bind:visiblechange="onCreateVisibleChange"
    bind:cancel="onCreateCancel"
    bind:confirm="onCreateConfirm"
  />
</view>
