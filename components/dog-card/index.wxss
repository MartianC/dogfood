.dog-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #25684a;
  color: #ffffff;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 30rpx;
  background: #edf4ee;
  display: block;
}

.body {
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 800;
}

.meta,
.goal {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit {
  width: 116rpx;
  height: 60rpx;
  border-radius: 999rpx;
  color: #25684a;
  background: #ffffff;
  font-size: 24rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.edit::after {
  border: 0;
}
