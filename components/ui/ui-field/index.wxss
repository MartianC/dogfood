@import "../../../styles/tokens.wxss";

.ui-field {
  box-sizing: border-box;
  min-height: 108rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-lg);
  background: var(--df-color-surface);
}

.ui-field__label {
  margin-bottom: 10rpx;
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
}

.ui-field__body {
  min-height: 58rpx;
  color: var(--df-color-text);
  font-size: 30rpx;
}

.ui-field__help {
  margin-top: 8rpx;
  color: var(--df-color-muted);
  font-size: var(--df-font-xs);
  line-height: 1.4;
}

.ui-field__error {
  margin-top: 8rpx;
  color: var(--df-color-warning);
  font-size: var(--df-font-xs);
  line-height: 1.4;
}

.ui-field--profile,
.ui-field--profile-choice,
.ui-field--profile-stage {
  min-height: 112rpx;
  padding: 16rpx 20rpx;
  border-color: var(--df-profile-color-field-line);
  border-radius: 24rpx;
  background: var(--df-profile-color-bg);
}

.ui-field--profile .ui-field__label,
.ui-field--profile-choice .ui-field__label,
.ui-field--profile-stage .ui-field__label {
  margin-bottom: 6rpx;
  color: var(--df-profile-color-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.ui-field--profile .ui-field__body,
.ui-field--profile-choice .ui-field__body,
.ui-field--profile-stage .ui-field__body {
  min-height: 38rpx;
  color: var(--df-profile-color-text);
  font-size: 28rpx;
  line-height: 38rpx;
}

.ui-field--profile .ui-field__error,
.ui-field--profile .ui-field__help,
.ui-field--profile-choice .ui-field__error,
.ui-field--profile-choice .ui-field__help,
.ui-field--profile-stage .ui-field__error,
.ui-field--profile-stage .ui-field__help {
  margin-top: 6rpx;
}

.ui-field--profile-choice {
  height: 112rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.ui-field--profile-choice .ui-field__label {
  margin-bottom: 0;
}

.ui-field--profile-choice .ui-field__body {
  height: 64rpx;
  min-height: 64rpx;
}

.ui-field--profile-stage {
  background: var(--df-profile-color-stage-bg);
}

.ui-field--profile-stage .ui-field__label,
.ui-field--profile-stage .ui-field__body {
  color: var(--df-profile-color-primary);
}

.ui-field--profile-stage .ui-field__label {
  color: var(--df-profile-color-muted);
}

.ui-field--profile-stage .ui-field__body {
  font-weight: 700;
}
