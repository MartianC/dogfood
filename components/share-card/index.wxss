@import "../../styles/tokens.wxss";

.share-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--df-color-text);
}

.share-meta {
  margin-top: 10rpx;
  color: var(--df-color-muted);
}

.share-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}
