.profile-form {
  display: grid;
  gap: 16rpx;
}

.avatar-picker {
  padding: 20rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 20rpx;
  background: #ffffff;
  display: grid;
  grid-template-columns: 108rpx 1fr;
  gap: 20rpx;
  align-items: center;
}

.avatar-preview {
  width: 108rpx;
  height: 108rpx;
  border: 1rpx solid #b7c7bc;
  border-radius: 28rpx;
  background: #edf4ee;
  display: block;
}

.avatar-title {
  color: #17201b;
  font-size: 28rpx;
  font-weight: 800;
}

.avatar-desc {
  margin-top: 8rpx;
  color: #6f7b73;
  font-size: 23rpx;
  line-height: 1.45;
}

.form-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.profile-form .field {
  min-height: 108rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 20rpx;
  background: #ffffff;
}

.target-panel {
  padding: 20rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 20rpx;
  background: #ffffff;
}

.panel-title {
  color: #17201b;
  font-size: 28rpx;
  font-weight: 800;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.option {
  min-height: 60rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 999rpx;
  background: #ffffff;
  color: #34423a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.option.active {
  border-color: rgba(37, 104, 74, 0.28);
  background: #e3f0e8;
  color: #25684a;
}
