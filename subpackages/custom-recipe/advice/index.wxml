<view wx:if="{{draft}}" class="page with-bottom-action">
  <view class="hero">
    <view class="eyebrow">食谱建议</view>
    <view class="title">{{draft.title}}</view>
    <view class="subtitle">{{draft.adviceSummary}}</view>
    <view class="meter"><view></view></view>
  </view>

  <view class="section stack">
    <advice-card wx:for="{{draft.advices}}" wx:key="ingredientName" advice="{{item}}" />
  </view>

  <view class="section notice warning">建议仅用于做饭前检查食材风险，不表达治疗承诺。有疾病或特殊状态时请咨询兽医。</view>

  <view class="bottom-action">
    <button class="button" bindtap="onChoosePeriod">按建议选择周期</button>
    <button class="button secondary" bindtap="onBackEdit">返回调整食材</button>
  </view>
</view>
