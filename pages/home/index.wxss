@import "../../styles/tokens.wxss";

.home-page {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-5);
}

.home-header {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-2);
}

.home-header__date,
.home-header__copy,
.home-draft__meta,
.home-issue__description,
.home-record__meta,
.home-section__hint {
  color: var(--df-color-muted);
}

.home-header__title,
.home-primary__title,
.home-draft__title,
.home-issue__title,
.home-record__title,
.home-error__title {
  overflow-wrap: anywhere;
  word-break: break-word;
}

.home-header__title {
  max-width: 15em;
}

.home-primary {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-3);
}

.home-primary--initializing {
  opacity: 0.78;
}

.home-primary__eyebrow {
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
  font-weight: 700;
  letter-spacing: 0.04em;
}

.home-primary__title {
  color: var(--df-color-text);
  font-size: var(--df-font-xl);
  font-weight: 800;
  line-height: 1.25;
}

.home-primary__description {
  color: var(--df-color-muted);
  line-height: 1.5;
}

.home-primary__loading {
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
}

.home-error {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-2);
}

.home-error__title {
  color: var(--df-color-warning);
  font-weight: 800;
}

.home-error__description {
  color: var(--df-color-warning);
  line-height: 1.5;
}

.home-error ui-button {
  align-self: flex-start;
}

.home-section {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-3);
}

.home-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-3);
}

.home-recent .home-section__head {
  position: relative;
}

.home-section__hint {
  flex: none;
  font-size: var(--df-font-xs);
}

.home-section__action {
  min-height: var(--df-touch-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
  font-weight: 700;
}

.home-recent .home-section__action {
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
}

.home-draft {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-2);
}

.home-section__state {
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--df-space-2);
  color: var(--df-color-muted);
  line-height: 1.5;
}

.home-section__state--error {
  color: var(--df-color-warning);
}

.home-section__state-copy {
  color: var(--df-color-muted);
}

.home-items .ui-card {
  min-height: 96rpx;
  box-sizing: border-box;
}

.home-issue--compact {
  padding: var(--df-space-2) 0;
}

.home-draft__title,
.home-record__title {
  color: var(--df-color-text);
  font-size: var(--df-font-lg);
  font-weight: 800;
  line-height: 1.35;
}

.home-summary__description,
.home-draft__meta,
.home-issue__description,
.home-record__meta {
  line-height: 1.5;
}

.home-issue-list {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-3);
}

.home-issue,
.home-record {
  min-width: 0;
  min-height: var(--df-touch-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--df-space-3);
}

.home-issue__copy,
.home-record__copy {
  min-width: 0;
  flex: 1;
}

.home-issue__title {
  color: var(--df-color-text);
  font-weight: 800;
  line-height: 1.35;
}

.home-issue__description,
.home-record__meta {
  margin-top: var(--df-space-1);
  font-size: var(--df-font-sm);
}

.home-issue__chevron,
.home-record__chevron {
  flex: none;
  color: var(--df-color-muted);
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.home-record__title {
  font-size: var(--df-font-md);
}

.home-recent {
  padding-bottom: var(--df-space-2);
}
