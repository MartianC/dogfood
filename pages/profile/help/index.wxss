@import "../../../styles/tokens.wxss";

.profile-help__intro {
  padding: 8rpx 4rpx 28rpx;
}

.profile-help__eyebrow {
  color: var(--df-color-primary);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.profile-help__title {
  margin-top: 8rpx;
  color: var(--df-color-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.profile-help__description {
  margin-top: 12rpx;
  color: var(--df-color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.profile-help__section-title,
.profile-help__subsection-title {
  color: var(--df-color-text);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
}

.profile-help__subsection-title {
  margin-top: 28rpx;
  font-size: 26rpx;
}

.profile-help__step {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.profile-help__step-number {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--df-radius-pill);
  color: var(--df-color-on-primary);
  background: var(--df-color-primary);
  font-size: 23rpx;
  font-weight: 800;
}

.profile-help__step-content {
  min-width: 0;
  flex: 1;
}

.profile-help__step-title {
  color: var(--df-color-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.profile-help__step-description,
.profile-help__paragraph {
  margin-top: 8rpx;
  color: var(--df-color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.profile-help__switch {
  min-height: var(--df-touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  color: var(--df-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}
