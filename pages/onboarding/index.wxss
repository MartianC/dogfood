@import "../../styles/tokens.wxss";

.onboarding-hero-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--df-color-bg);
}

.onboarding-hero-media {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  left: 0;
  height: 72vh;
  overflow: hidden;
}

.onboarding-hero-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.onboarding-hero-fade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 360rpx;
  background: linear-gradient(to bottom, transparent, var(--df-color-bg) 76%);
}

.onboarding-hero-copy {
  position: absolute;
  z-index: 2;
  right: 48rpx;
  bottom: calc(52rpx + constant(safe-area-inset-bottom));
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  left: 48rpx;
}

.onboarding-hero-title {
  max-width: 620rpx;
  color: var(--df-color-text);
  font-size: 78rpx;
  font-weight: 900;
  line-height: 1.1;
}

.onboarding-hero-title text {
  display: block;
}

.onboarding-hero-description {
  max-width: 572rpx;
  margin-top: 28rpx;
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-md);
  line-height: 1.65;
}

.onboarding-hero-meta {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  font-weight: 700;
  line-height: 32rpx;
}

.onboarding-hero-meta__line {
  width: 48rpx;
  height: 2rpx;
  flex: none;
  background: var(--df-color-primary);
}

.onboarding-hero-action {
  margin-top: 32rpx;
}

.onboarding-hero-login {
  min-height: var(--df-touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-sm);
}

.onboarding-hero-login__prompt {
  color: var(--df-color-muted);
  font-weight: 400;
}

.onboarding-hero-login__action {
  margin-left: 8rpx;
  color: var(--df-color-primary);
  font-weight: 700;
}

@media (max-height: 700px) {
  .onboarding-hero-copy {
    right: 40rpx;
    bottom: constant(safe-area-inset-bottom);
    bottom: env(safe-area-inset-bottom);
    left: 40rpx;
  }

  .onboarding-hero-title {
    max-width: 600rpx;
    font-size: 68rpx;
  }

  .onboarding-hero-description {
    margin-top: 18rpx;
    line-height: 1.5;
  }

  .onboarding-hero-meta {
    margin-top: 20rpx;
  }

  .onboarding-hero-action {
    margin-top: 24rpx;
  }
}
