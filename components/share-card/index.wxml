<ui-card>
  <view class="share-title">{{plan.recipeName || '狗饭批量制作清单'}}</view>
  <view class="share-meta">{{plan.periodDays}} 天｜共 {{plan.totalPortions}} 份</view>
  <view class="share-actions">
    <ui-button variant="secondary" bind:tap="exportImage">导出图片</ui-button>
    <ui-button openType="share">分享</ui-button>
  </view>
</ui-card>
