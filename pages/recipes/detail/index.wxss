.detail-cover {
  width: 100%;
  height: 390rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: 28rpx;
  background: var(--df-color-surface-muted);
  display: block;
  box-shadow: var(--df-shadow-card);
}

.detail-head {
  margin-top: 26rpx;
}

.tag-list {
  margin-top: 16rpx;
}

.ratio-row,
.step-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--df-color-surface-muted);
}

.ratio-row:last-child,
.step-row:last-child {
  border-bottom: 0;
}

.step-row {
  justify-content: flex-start;
  line-height: 1.5;
}

.step-num {
  flex: 0 0 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--df-color-primary-soft);
  color: var(--df-color-primary);
  text-align: center;
  line-height: 44rpx;
  font-weight: 800;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  box-sizing: border-box;
  background: var(--df-color-mask);
}

.sheet {
  width: 100%;
  padding: 36rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  background: var(--df-color-surface);
  box-shadow: var(--df-shadow-sheet);
}

.sheet-title {
  margin-top: 8rpx;
  color: var(--df-color-text);
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.sheet-desc {
  margin-top: 16rpx;
  color: var(--df-color-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.sheet-action {
  margin-top: 32rpx;
}
