<t-cell-group theme="card" bordered t-class="recipe-ingredient-list__group">
  <t-cell
    wx:for="{{items}}"
    wx:key="id"
    title="{{item.name}}"
    description="{{item.displayDescription || item.categoryLabel}}"
    hover="{{mode === 'search' && !item.blockedByDogAllergy}}"
    t-class="recipe-ingredient-list__cell recipe-ingredient-list__cell--{{mode}} {{item.blockedByDogAllergy ? 'recipe-ingredient-list__cell--blocked' : ''}}"
    data-index="{{index}}"
    bind:click="onCellClick"
  >
    <view wx:if="{{mode === 'edit'}}" slot="note" class="recipe-ingredient-list__amount">
      <text class="recipe-ingredient-list__ratio">{{item.ratioPercent}}%</text>
      <t-input
        t-class="recipe-ingredient-list__input"
        type="number"
        align="right"
        borderless
        value="{{item.perMealAmountGram}}"
        suffix="g"
        aria-label="{{item.name}}克重"
        data-index="{{index}}"
        bind:change="onAmountInput"
      />
    </view>
    <view
      wx:if="{{item.blockedByDogAllergy}}"
      slot="right-icon"
      class="recipe-ingredient-list__blocked-label"
    >不能添加</view>
    <view
      wx:else
      slot="right-icon"
      class="recipe-ingredient-list__action recipe-ingredient-list__action--{{mode}}"
      data-index="{{index}}"
      catchtap="onActionTap"
      aria-label="{{mode === 'edit' ? '删除食材' : '添加食材'}}"
    >
      <image class="recipe-ingredient-list__action-icon" src="{{actionIcon}}" mode="aspectFit" />
    </view>
  </t-cell>
</t-cell-group>
