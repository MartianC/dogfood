.df-stack {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-4);
}

.df-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-4);
}

.df-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--df-space-6) var(--df-space-6) 48rpx;
}

.df-page-with-bottom-action {
  padding-bottom: calc(176rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}
