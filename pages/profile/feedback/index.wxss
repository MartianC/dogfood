@import "../../../styles/tokens.wxss";

.profile-feedback__intro {
  padding: 8rpx 4rpx 28rpx;
}

.profile-feedback__title {
  color: var(--df-color-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.profile-feedback__description,
.profile-feedback__footer,
.profile-feedback__hint {
  color: var(--df-color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.profile-feedback__description {
  margin-top: 12rpx;
}

.profile-feedback__qr {
  width: 100%;
  height: 520rpx;
  display: block;
}

.profile-feedback__error {
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--df-color-warning);
  background: var(--df-color-warning-soft);
  font-size: 24rpx;
  text-align: center;
}

.profile-feedback__hint {
  margin-top: 16rpx;
  text-align: center;
}

.profile-feedback__footer {
  padding: 24rpx 4rpx;
  text-align: center;
}
