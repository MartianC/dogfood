<view class="page">
  <view wx:if="{{authState !== 'has-profile'}}" class="hero">
    <view class="eyebrow">狗饭清单工具</view>
    <view class="title">先看食谱，需要清单时再建档</view>
    <view class="subtitle">浏览食谱不需要登录。添加狗狗后，可按每日餐数和制作周期换算采购总量。</view>
    <view class="button-row">
      <button class="button" bindtap="onAddDog">添加狗狗档案</button>
      <button class="button secondary" bindtap="onBrowseRecipes">先浏览食谱</button>
    </view>
  </view>

  <view wx:else class="section">
    <view class="section-head">
      <view class="section-title">全部狗狗档案</view>
      <view class="link" bindtap="onAddDog">新增</view>
    </view>
    <view class="stack">
      <dog-card wx:for="{{dogs}}" wx:key="id" dog="{{item}}" editable bind:editdog="onEditDog" />
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{authState === 'has-profile' ? '适合全部狗狗' : '推荐食谱'}}</view>
      <view class="link" bindtap="onBrowseRecipes">全部</view>
    </view>
    <view class="stack">
      <recipe-card wx:for="{{recommendations}}" wx:key="id" recipe="{{item}}" showFit="{{authState === 'has-profile'}}" bind:taprecipe="onRecipeTap" />
    </view>
  </view>

  <view wx:if="{{latestPlan}}" class="section">
    <view class="notice good" bindtap="onOpenPlan">最近一次清单：{{latestPlan.recipeName}}，{{latestPlan.periodDays}} 天批量制作。</view>
  </view>
</view>
