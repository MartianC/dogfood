@import "../../../styles/tokens.wxss";

:host {
  --td-brand-color: var(--df-color-primary);
  --td-brand-color-active: var(--df-color-primary-pressed);
  --td-text-color-primary: var(--df-color-text);
  --td-text-color-placeholder: var(--df-color-muted);
  --td-bg-color-container: var(--df-color-surface);
  --td-search-bg-color: transparent;
  --td-search-text-color: var(--df-color-text);
  --td-search-placeholder-color: var(--df-color-muted);
  --td-search-border-color: var(--df-color-line);
  --td-search-action-color: var(--df-color-primary);
  --td-search-height: 84rpx;
  --td-search-icon-size: 40rpx;
  --td-search-font: var(--df-font-md) / 36rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.recipe-ingredient-search__root {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 16rpx 0 28rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-xl);
  background: var(--df-color-surface);
}

.recipe-ingredient-search__input-container {
  min-width: 0;
  padding: 0;
}

.recipe-ingredient-search__input {
  min-width: 0;
  padding-left: 20rpx;
}

.recipe-ingredient-search__action {
  flex: 0 0 68rpx;
  margin-left: var(--df-space-3);
  color: var(--df-color-primary);
  font-size: 26rpx;
  line-height: 36rpx;
}
