<view class="page profile-page">
  <view class="profile-card">
    <image class="avatar" src="{{(user && user.avatarUrl) || defaultDogAvatar}}" mode="aspectFill" />
    <view class="profile-main">
      <view class="profile-title">{{authState === 'guest' ? '游客模式' : (user.nickname || '微信用户')}}</view>
      <view class="profile-meta">{{authState === 'guest' ? '登录后管理狗狗档案、历史清单和自定义食谱' : ('已创建 ' + dogs.length + ' 只狗狗档案')}}</view>
    </view>
    <view class="status-tag {{authState === 'guest' ? '' : 'good'}}">{{authState === 'guest' ? '未登录' : '已登录'}}</view>
  </view>

  <view wx:if="{{authState === 'guest'}}" class="section guest-panel">
    <view class="panel-title">登录后管理狗狗档案</view>
    <view class="panel-desc">生成清单、保存历史和自定义食谱前，需要先登录并添加狗狗档案。</view>
    <button class="button" bindtap="onLogin">微信登录并添加狗狗</button>
  </view>

  <view wx:else class="section">
    <view class="section-head">
      <view class="section-title">狗狗档案</view>
      <view class="link" bindtap="onAddDog">新增</view>
    </view>
    <view wx:if="{{dogs.length}}" class="profile-dog-list">
      <view wx:for="{{dogs}}" wx:key="id" class="dog-panel">
        <image class="dog-avatar" src="{{item.avatarUrl || defaultDogAvatar}}" mode="aspectFill" />
        <view class="dog-copy">
          <view class="dog-panel-head">
            <text>{{item.name}}</text>
            <text class="edit-link" data-id="{{item.id}}" bindtap="onEditDogPanel">修改</text>
          </view>
          <view class="dog-meta">{{ageStageLabels[item.ageStage]}}｜{{item.weightKg}}kg｜每日 {{item.dailyMeals}} 餐｜{{dietGoalLabels[item.dietGoal] || '日常'}}饮食</view>
        </view>
      </view>
    </view>
    <empty-state wx:else title="还没有狗狗档案" description="先添加一只狗狗，生成清单时会自动换算份量。" actionText="添加狗狗" image-url="{{defaultDogAvatar}}" bind:action="onAddDog" />
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="onHistory">
      <text>历史清单</text>
      <text class="chevron">›</text>
    </view>
    <view class="menu-item" bindtap="onCustomRecipes">
      <text>我的自定义食谱</text>
      <text class="chevron">›</text>
    </view>
    <view class="menu-item">
      <text>饮食偏好</text>
      <text class="chevron">›</text>
    </view>
    <view class="menu-item">
      <text>过敏源管理</text>
      <text class="chevron">›</text>
    </view>
  </view>
</view>
