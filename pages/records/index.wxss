@import "../../styles/tokens.wxss";

.records-page {
  padding-top: 0;
}

.records-calendar-shell {
  margin-right: -32rpx;
  margin-left: -32rpx;
  background: var(--df-color-surface);
}

.records-content {
  padding-top: var(--df-space-3);
}

.records-state {
  padding-top: var(--df-space-5);
}

.records-state__heading,
.records-day-heading__title {
  min-width: 0;
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  font-weight: 800;
  line-height: 1.35;
}

.records-state__description,
.records-day-heading__description,
.records-entry__summary {
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 1.45;
}

.records-state__description,
.records-day-heading__description {
  margin-top: var(--df-space-1);
}

.records-state__action,
.records-source-notice__action,
.records-empty-action {
  display: flex;
  justify-content: flex-start;
  margin-top: var(--df-space-4);
}

.records-refresh-notice,
.records-source-notice,
.records-dog-groups,
.records-list {
  margin-top: var(--df-space-5);
}

.records-day-heading {
  margin-top: var(--df-space-4);
}

.records-dog-groups,
.records-list {
  display: grid;
  gap: var(--df-space-4);
}

.records-dog-group {
  min-width: 0;
}

.records-dog-group__header {
  box-sizing: border-box;
  min-height: var(--df-touch-min);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-3);
  padding: var(--df-space-2) 0;
}

.records-dog-group__identity {
  min-width: 0;
  flex: 1;
}

.records-dog-group__name {
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.records-dog-group__toggle {
  flex: none;
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
  font-weight: 700;
}

.records-dog-group__records {
  display: grid;
  gap: var(--df-space-3);
  padding-top: var(--df-space-2);
}

.records-entry {
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: var(--df-space-3);
}

.records-entry__content {
  min-width: 0;
  flex: 1;
}

.records-entry__meta {
  min-height: 34rpx;
  display: flex;
  align-items: center;
}

.records-entry__heading {
  min-width: 0;
  margin-top: var(--df-space-2);
  color: var(--df-color-text);
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.records-entry__summary {
  margin-top: var(--df-space-1);
  overflow-wrap: anywhere;
}

.records-entry__chevron {
  flex: none;
  color: var(--df-color-muted);
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
