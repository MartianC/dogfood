@import "../../../styles/tokens.wxss";

page {
  background: var(--df-color-bg);
}

.shared-meal-menu-page {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-5);
}

.shared-meal-menu-results,
.shared-meal-menu-detail {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-4);
}

.shared-meal-menu-loading {
  padding: var(--df-space-6);
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  text-align: center;
}

.shared-meal-menu-result {
  min-height: var(--df-touch-min);
}

.shared-meal-menu-result__name,
.shared-meal-menu-detail__name {
  color: var(--df-color-text);
  font-size: var(--df-font-lg);
  font-weight: 700;
  line-height: 48rpx;
}

.shared-meal-menu-result__meta,
.shared-meal-menu-detail__hint,
.shared-meal-menu-ingredient__amount,
.shared-meal-menu-ingredient__unmapped,
.shared-meal-menu-component__reason {
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 36rpx;
}

.shared-meal-menu-ingredient {
  min-width: 0;
}

.shared-meal-menu-ingredient__source {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--df-space-2);
  color: var(--df-color-text);
  font-weight: 700;
}

.shared-meal-menu-ingredient__unmapped {
  margin-top: var(--df-space-3);
}

.shared-meal-menu-component {
  box-sizing: border-box;
  min-height: var(--df-touch-min);
  margin-top: var(--df-space-3);
  padding: var(--df-space-3);
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-md);
}

.shared-meal-menu-component--open {
  background: var(--df-color-primary-soft);
}

.shared-meal-menu-component--blocked {
  background: var(--df-color-warning-soft);
}

.shared-meal-menu-component__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-3);
}

.shared-meal-menu-component__reason {
  margin-top: var(--df-space-2);
  color: var(--df-color-warning);
}
