<view
  wx:if="{{removable}}"
  class="ui-tag-remove-target"
  bindtap="handleRemove"
  aria-role="button"
  aria-label="移除已选菜单"
>
  <view class="ui-tag ui-tag--{{variant}} ui-tag--{{size}} ui-tag--removable-pill">
    <slot />
    <image
      class="ui-tag__remove-icon"
      src="/assets/icons/tdesign/close-primary.svg"
      mode="aspectFit"
      aria-hidden="true"
    />
  </view>
</view>

<view wx:else class="ui-tag ui-tag--{{variant}} ui-tag--{{size}}">
  <slot />
</view>
