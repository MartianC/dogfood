.period {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.option {
  height: 78rpx;
  border: 1rpx solid #d8e1da;
  border-radius: 18rpx;
  background: #ffffff;
  color: #34423a;
  line-height: 78rpx;
  text-align: center;
  font-weight: 700;
}

.option.active {
  border-color: rgba(37, 104, 74, 0.28);
  background: #e3f0e8;
  color: #25684a;
}

.custom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #d8e1da;
}

.custom-input {
  flex: 1;
  min-height: 58rpx;
  text-align: center;
  font-weight: 800;
}
