<view class="page with-tab-bar records-page">
  <ui-notice wx:if="{{errorText}}" variant="warning" clickable="{{true}}" bind:tap="onShow">{{errorText}}</ui-notice>
  <view wx:if="{{loading}}" class="records-loading">正在读取本餐记录</view>
  <ui-empty wx:elif="{{!records.length}}" title="还没有本餐记录" description="从已经决定的人饭菜单开始，记录一顿给狗狗单独制作的饭。" actionText="记录第一顿" bind:action="onCreateMeal" />
  <view wx:else class="records-list">
    <ui-card wx:for="{{records}}" wx:key="id" padding="small">
      <view class="records-entry" data-id="{{item.id}}" aria-role="button" aria-label="查看{{item.dogName}}的本餐记录" bindtap="onOpenRecord">
        <view class="records-entry__head">
          <view class="records-entry__dog">{{item.dogName}}</view>
          <ui-tag variant="neutral">{{item.mealTimeText}}</ui-tag>
        </view>
        <view class="records-entry__menu">{{item.menuText}}</view>
        <view class="records-entry__meta">{{item.ingredientCount}} 种狗饭食材 · {{item.assessmentText}}</view>
      </view>
    </ui-card>
  </view>
</view>
