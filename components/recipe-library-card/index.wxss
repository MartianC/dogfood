@import "../../styles/tokens.wxss";

.recipe-library-card {
  display: block;
  min-width: 0;
  transition: opacity 120ms ease;
}

.recipe-library-card--pressed {
  opacity: 0.72;
}

.recipe-library-card__head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: var(--df-space-3);
}

.recipe-library-card__name {
  min-width: 0;
  color: var(--df-color-text);
  font-size: var(--df-font-lg);
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.recipe-library-card__detail,
.recipe-library-card__metrics {
  margin-top: var(--df-space-3);
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.recipe-library-card__metrics {
  margin-top: var(--df-space-2);
}
