<view class="page with-bottom-action">
  <view class="hero">
    <view class="eyebrow">狗狗档案</view>
    <view class="title">{{id ? '修改档案' : '添加狗狗'}}</view>
    <view class="subtitle">生成清单需要名字、年龄阶段、体重和每日餐数，其他资料可以稍后补充。</view>
  </view>

  <view class="section">
    <ui-card>
      <view class="profile-form">
        <view class="avatar-picker" bindtap="onChooseAvatar">
          <image class="avatar-preview" src="{{form.avatarUrl || defaultDogAvatar}}" mode="aspectFill" />
          <view class="avatar-copy">
            <view class="avatar-title">狗狗头像</view>
            <view class="avatar-desc">点击更换照片，保存后用于档案和制作对象选择。</view>
          </view>
        </view>

        <ui-field label="狗狗名字">
          <input class="form-control" data-key="name" value="{{form.name}}" bindinput="setField" placeholder="例如 布丁" />
        </ui-field>

        <view class="form-pair">
          <ui-field label="年龄阶段">
            <picker range="{{ageStageOptions}}" range-key="label" value="{{ageIndex}}" bindchange="onAge">
              <view class="picker-value">{{ageStageOptions[ageIndex].label}}</view>
            </picker>
          </ui-field>
          <ui-field label="体重 kg">
            <input class="form-control" type="digit" data-key="weightKg" value="{{form.weightKg}}" bindinput="setField" placeholder="例如 12" />
          </ui-field>
        </view>

        <view class="form-pair">
          <ui-field label="每日餐数">
            <input class="form-control" type="number" data-key="dailyMeals" value="{{form.dailyMeals}}" bindinput="setField" placeholder="例如 2" />
          </ui-field>
          <ui-field label="过敏源，可跳过">
            <input class="form-control" value="{{allergenText}}" bindinput="onAllergenText" placeholder="例如 鸡肉" />
          </ui-field>
        </view>

        <view class="target-panel">
          <view class="panel-title">饮食目标</view>
          <view class="option-row">
            <view wx:for="{{dietGoalOptions}}" wx:key="value" data-index="{{index}}" bindtap="onGoalTap">
              <ui-tag variant="{{goalIndex === index ? 'good' : 'neutral'}}">{{item.label}}</ui-tag>
            </view>
          </view>
        </view>

        <ui-field label="忌口食材，可跳过">
          <input class="form-control" value="{{avoidText}}" bindinput="onAvoidText" placeholder="例如 南瓜、熟米饭" />
        </ui-field>
      </view>
    </ui-card>
  </view>

  <view wx:if="{{id}}" class="delete-action">
    <ui-button variant="warning" bind:tap="onDelete">删除档案</ui-button>
  </view>

  <view class="bottom-action">
    <ui-button bind:tap="onSave">保存</ui-button>
  </view>
</view>
