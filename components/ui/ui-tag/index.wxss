@import "../../../styles/tokens.wxss";

:host {
  display: inline-block;
}

.ui-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: var(--df-radius-pill);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
}

.ui-tag--small {
  min-height: 34rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
}

.ui-tag--large {
  min-height: 56rpx;
  padding: 0 32rpx;
  font-size: var(--df-font-xs);
  white-space: nowrap;
  word-break: normal;
}

.ui-tag--neutral {
  color: var(--df-color-text-secondary);
  background: var(--df-color-surface-muted);
}

.ui-tag--good {
  color: var(--df-color-primary);
  background: var(--df-color-primary-soft);
}

.ui-tag--warning {
  color: var(--df-color-warning);
  background: var(--df-color-warning-soft);
}

.ui-tag-remove-target {
  display: inline-flex;
  min-height: var(--df-touch-min);
  align-items: center;
}

.ui-tag--removable-pill {
  min-height: 72rpx;
  gap: var(--df-space-4);
  padding-right: var(--df-space-5);
  padding-left: var(--df-space-5);
  font-weight: 400;
}

.ui-tag__remove-icon {
  flex: 0 0 auto;
  color: var(--df-color-primary);
}
