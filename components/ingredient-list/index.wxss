@import "../../styles/tokens.wxss";

.ingredient-list {
  border: 1rpx solid var(--df-color-line);
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--df-color-surface);
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid var(--df-color-surface-muted);
}

.item:last-child {
  border-bottom: 0;
}

.left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--df-color-line-strong);
}

.check.checked {
  background: var(--df-color-primary);
  border-color: var(--df-color-primary);
}

.name {
  font-weight: 700;
  color: var(--df-color-text);
}

.category {
  margin-top: 4rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
}

.amount {
  color: var(--df-color-primary);
  font-weight: 800;
}
