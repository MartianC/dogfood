@import "../../../styles/tokens.wxss";

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-account-entry {
  display: block;
  color: inherit;
  text-decoration: none;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.profile-title {
  color: var(--df-color-text);
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.profile-meta {
  margin-top: 8rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-sections {
  display: grid;
  gap: 32rpx;
  margin-top: 32rpx;
}

.profile-section {
  min-width: 0;
}

.profile-section__heading {
  margin: 0 0 16rpx 4rpx;
  color: var(--df-color-text-secondary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.profile-item {
  box-sizing: border-box;
  min-height: var(--df-touch-min);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  color: inherit;
  text-decoration: none;
}

.profile-item:active {
  background: var(--df-color-surface-pressed);
}

.profile-item__content {
  min-width: 0;
  flex: 1;
}

.profile-item__title {
  color: var(--df-color-text);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.profile-item__description {
  margin-top: 6rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-item__chevron {
  flex: none;
  color: var(--df-color-muted);
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.profile-item__divider {
  height: 1rpx;
  margin: 0 24rpx;
  background: var(--df-color-line);
}

.profile-item--static {
  min-height: 80rpx;
}

.profile-item__value {
  flex: none;
  color: var(--df-color-muted);
  font-size: 23rpx;
}

.profile-account-entry__chevron {
  flex: none;
  color: var(--df-color-muted);
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.profile-about-note {
  margin-top: 20rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}
