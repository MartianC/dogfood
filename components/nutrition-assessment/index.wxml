<view class="nutrition-assessment">
  <view
    class="nutrition-assessment__summary {{compact ? 'nutrition-assessment__summary--compact' : ''}}"
    hover-class="nutrition-assessment__summary--pressed"
    aria-role="button"
    aria-label="查看本餐评估详情"
    bindtap="onToggle"
  >
    <view class="nutrition-assessment__handle"></view>
    <view class="nutrition-assessment__summary-head">
      <view class="nutrition-assessment__summary-heading">本餐评估</view>
      <view class="nutrition-assessment__summary-link">查看详情 ›</view>
    </view>
    <block wx:if="{{loading}}">
      <view class="nutrition-assessment__summary-status">正在评估</view>
      <view class="nutrition-assessment__summary-advice">正在读取食材营养和参考标准</view>
    </block>
    <block wx:elif="{{viewAssessment}}">
      <view class="nutrition-assessment__axis">
        <view class="nutrition-assessment__axis-status nutrition-assessment__axis-status--{{viewAssessment.energy.status}}">
          {{viewAssessment.energy.statusLabel}}
        </view>
        <view class="nutrition-assessment__axis-description">{{viewAssessment.energy.summaryText}}</view>
      </view>
      <view class="nutrition-assessment__axis">
        <view class="nutrition-assessment__axis-status nutrition-assessment__axis-status--{{viewAssessment.nutritionDensity.status}}">
          营养密度{{viewAssessment.nutritionDensity.statusLabel}}
        </view>
        <view class="nutrition-assessment__axis-description">{{viewAssessment.nutritionDensity.primaryAdvice}}</view>
      </view>
    </block>
  </view>

  <view
    wx:if="{{expandedMounted}}"
    class="nutrition-assessment__expanded-backdrop"
    catchtap="onToggle"
    aria-role="button"
    aria-label="收起本餐评估"
  ></view>

  <view
    wx:if="{{expandedMounted}}"
    class="nutrition-assessment__expanded nutrition-assessment__expanded--{{expandedPhase}}"
    bindtouchstart="onExpandedTouchStart"
    bindtouchmove="onExpandedTouchMove"
    bindtouchend="onExpandedTouchEnd"
    bindtouchcancel="onExpandedTouchCancel"
  >
    <view
      class="nutrition-assessment__expanded-grabber"
      bindtouchstart="onExpandedTouchStart"
      bindtouchmove="onExpandedTouchMove"
      bindtouchend="onExpandedTouchEnd"
      bindtouchcancel="onExpandedTouchCancel"
      aria-role="button"
      aria-label="在页面顶部向下滑动收起本餐评估"
    >
      <view class="nutrition-assessment__handle"></view>
    </view>
    <scroll-view
      class="nutrition-assessment__scroll"
      scroll-y
      upper-threshold="0"
      enable-flex
      bindscroll="onExpandedScroll"
      bindscrolltoupper="onExpandedScrollToUpper"
      bindtouchstart="onExpandedTouchStart"
      bindtouchmove="onExpandedTouchMove"
      bindtouchend="onExpandedTouchEnd"
      bindtouchcancel="onExpandedTouchCancel"
    >
      <view class="nutrition-assessment__expanded-content">
        <view class="nutrition-assessment__expanded-head">
          <view>
            <view class="nutrition-assessment__expanded-title">本餐评估</view>
            <view wx:if="{{viewAssessment}}" class="nutrition-assessment__expanded-context">{{viewAssessment.contextText}}</view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="nutrition-assessment__loading">正在读取能量、营养数据和参考标准</view>

        <block wx:elif="{{viewAssessment}}">
          <view class="nutrition-assessment__basis">{{viewAssessment.basisText}}</view>

          <view class="nutrition-assessment__energy-section">
            <view class="nutrition-assessment__section-label">份量与能量</view>
            <view class="nutrition-assessment__energy-status nutrition-assessment__energy-status--{{viewAssessment.energy.status}}">
              {{viewAssessment.energy.statusLabel}}
            </view>
            <view wx:if="{{viewAssessment.energy.available}}" class="nutrition-assessment__energy-grid">
              <view class="nutrition-assessment__energy-metric">
                <view class="nutrition-assessment__energy-metric-label">本餐实际</view>
                <view class="nutrition-assessment__energy-metric-value">{{viewAssessment.energy.currentKcalText}}</view>
              </view>
              <view class="nutrition-assessment__energy-metric">
                <view class="nutrition-assessment__energy-metric-label">本餐目标</view>
                <view class="nutrition-assessment__energy-metric-value">{{viewAssessment.energy.mealTargetText}}</view>
              </view>
            </view>
            <view wx:if="{{viewAssessment.energy.dailyTargetText}}" class="nutrition-assessment__energy-note">
              每日估算目标 {{viewAssessment.energy.dailyTargetText}}
            </view>
            <view wx:if="{{viewAssessment.energy.rangeStartText}}" class="nutrition-assessment__energy-note">
              {{viewAssessment.energy.rangeStartText}}
            </view>
            <view wx:if="{{viewAssessment.energy.provisional}}" class="nutrition-assessment__energy-note">
              当前使用兼容或默认活动口径估算，完善活动时长后会自动更新。
            </view>
            <view wx:if="{{viewAssessment.energy.bodyConditionNote}}" class="nutrition-assessment__energy-note">
              {{viewAssessment.energy.bodyConditionNote}}
            </view>
            <view wx:if="{{!viewAssessment.energy.available}}" class="nutrition-assessment__missing">
              <view class="nutrition-assessment__missing-heading">暂无法判断本餐份量</view>
              <view wx:if="{{viewAssessment.energy.knownKcalText}}" class="nutrition-assessment__missing-item">
                已知食材至少提供 {{viewAssessment.energy.knownKcalText}}
              </view>
              <view wx:for="{{viewAssessment.energy.missingIngredients}}" wx:key="id" class="nutrition-assessment__missing-item">
                {{item.name}}：{{item.reason}}
              </view>
              <view wx:if="{{viewAssessment.energy.missingIngredients.length}}" class="nutrition-assessment__missing-note">缺失值不会按 0 计算</view>
            </view>
            <view wx:if="{{viewAssessment.energy.scaleSuggestion.available}}" class="nutrition-assessment__scale-action">
              <ui-button variant="secondary" bind:tap="onOpenScalePreview">按目标调整整餐份量</ui-button>
            </view>
            <view wx:if="{{viewAssessment.needsProfileCompletion}}" class="nutrition-assessment__profile-completion">
              <ui-button variant="secondary" bind:tap="onCompleteProfile">{{viewAssessment.profileActionLabel}}</ui-button>
            </view>
            <view class="nutrition-assessment__energy-disclaimer">不包含零食及其他额外喂食；估算值请结合体重变化持续校正。</view>
          </view>

          <view class="nutrition-assessment__density-section">
            <view class="nutrition-assessment__section-label">营养密度</view>
            <view class="nutrition-assessment__conclusion-status nutrition-assessment__conclusion-status--{{viewAssessment.nutritionDensity.status}}">
              {{viewAssessment.nutritionDensity.statusLabel}}
            </view>
            <view class="nutrition-assessment__conclusion-advice">{{viewAssessment.nutritionDensity.primaryAdvice}}</view>
            <view class="nutrition-assessment__conclusion-counts">
              {{viewAssessment.nutritionDensity.counts.adjust}} 项建议调整 · {{viewAssessment.nutritionDensity.counts.met}} 项处于参考范围 · {{viewAssessment.nutritionDensity.counts.unavailable}} 项无法评估
            </view>
          </view>

          <block wx:if="{{viewAssessment.nutritionDensity.available}}">
            <view wx:for="{{viewAssessment.nutritionDensity.standards}}" wx:key="key" class="nutrition-assessment__standard">
              <view class="nutrition-assessment__standard-head">
                <view class="nutrition-assessment__standard-title">{{item.key === 'gb' ? '国标评估' : 'FEDIAF 评估'}}</view>
                <view class="nutrition-assessment__profile-link" aria-role="button" aria-label="更改{{item.key === 'gb' ? '国标' : 'FEDIAF'}}参考档案" data-key="{{item.key}}" bindtap="onOpenProfileSelector">{{item.shortProfileName}} · 更改 ›</view>
              </view>
              <view class="nutrition-assessment__standard-source">{{item.code}} · {{item.profileSelection === 'manual' ? '已手动选择' : '根据狗狗档案自动选择'}}</view>

              <view wx:for="{{item.highItems}}" wx:for-item="nutrient" wx:key="code" class="nutrition-assessment__item nutrition-assessment__item--high">
                <view class="nutrition-assessment__item-title">需要控制 · {{nutrient.name}}</view>
                <view class="nutrition-assessment__item-value">当前 {{nutrient.currentText}} · 参考要求 {{nutrient.requirementText}}</view>
                <view class="nutrition-assessment__contributors">主要来源：{{nutrient.contributorsText || '暂无可靠来源数据'}}</view>
                <ui-button variant="secondary" size="small" data-standard="{{item.key}}" data-code="{{nutrient.code}}" bind:tap="onHighAction">{{nutrient.actionText}} ›</ui-button>
              </view>

              <view wx:for="{{item.lowItems}}" wx:for-item="nutrient" wx:key="code" class="nutrition-assessment__item nutrition-assessment__item--low">
                <view class="nutrition-assessment__item-title">需要补充 · {{nutrient.name}}</view>
                <view class="nutrition-assessment__item-value">当前 {{nutrient.currentText}} · 参考要求 {{nutrient.requirementText}}</view>
                <ui-button variant="secondary" size="small" data-standard="{{item.key}}" data-code="{{nutrient.code}}" bind:tap="onLowAction">{{nutrient.actionText}} ›</ui-button>
              </view>

              <view class="nutrition-assessment__met">✓ 处于参考范围 · {{item.metCount}} 项</view>
              <view wx:if="{{item.unavailableCount}}" class="nutrition-assessment__unavailable">{{item.unavailableCount}} 项因数据不足无法评估</view>
            </view>

            <view class="nutrition-assessment__elements-entry" aria-role="button" aria-label="{{elementsVisible ? '收起' : '展开'}}全部元素对照" bindtap="onToggleElements">
              <view>
                <view class="nutrition-assessment__elements-heading">全部元素对照</view>
                <view class="nutrition-assessment__elements-description">查看所有元素的含量、标准要求和满足情况</view>
              </view>
              <view class="nutrition-assessment__elements-arrow">{{elementsVisible ? '收起' : '展开'}} ›</view>
            </view>

            <view wx:if="{{elementsVisible}}" class="nutrition-assessment__elements">
              <view class="nutrition-assessment__filters">
                <view class="nutrition-assessment__filter {{elementFilter === 'all' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="all" bindtap="onElementFilter">全部</view>
                <view class="nutrition-assessment__filter {{elementFilter === 'adjust' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="adjust" bindtap="onElementFilter">需调整</view>
                <view class="nutrition-assessment__filter {{elementFilter === 'met' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="met" bindtap="onElementFilter">范围内</view>
                <view class="nutrition-assessment__filter {{elementFilter === 'unavailable' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="unavailable" bindtap="onElementFilter">无法评估</view>
              </view>
              <scroll-view class="nutrition-assessment__table-scroll" scroll-x>
                <view class="nutrition-assessment__table">
                  <view class="nutrition-assessment__table-row nutrition-assessment__table-row--head">
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-cell--name">营养元素</view>
                    <view class="nutrition-assessment__table-cell">本餐含量</view>
                    <view class="nutrition-assessment__table-cell">国标要求</view>
                    <view class="nutrition-assessment__table-cell">FEDIAF 要求</view>
                  </view>
                  <view wx:for="{{filteredElements}}" wx:key="code" class="nutrition-assessment__table-row">
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-cell--name">{{item.name}}</view>
                    <view class="nutrition-assessment__table-cell">{{item.currentText}}</view>
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-status--{{item.gb.status}}"><view>{{item.gb.requirementText}}</view><view>{{item.gbStatusLabel}}</view></view>
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-status--{{item.fediaf.status}}"><view>{{item.fediaf.requirementText}}</view><view>{{item.fediafStatusLabel}}</view></view>
                  </view>
                </view>
              </scroll-view>
            </view>
          </block>

          <view wx:else class="nutrition-assessment__missing">
            <view class="nutrition-assessment__missing-heading">暂无法判断营养密度</view>
            <view wx:for="{{viewAssessment.nutritionDensity.missingIngredients}}" wx:key="id" class="nutrition-assessment__missing-item">{{item.name}}：{{item.reason}}</view>
            <view class="nutrition-assessment__missing-note">缺失值不会按 0 计算</view>
            <view class="nutrition-assessment__retry"><ui-button variant="secondary" size="small" bind:tap="onRetry">重新评估</ui-button></view>
          </view>

          <view class="nutrition-assessment__disclaimer">本餐评估用于份量与配方参考，结果依据食材数据、狗狗档案和所选标准计算。如有健康问题或特殊营养需求，请咨询兽医或宠物营养专业人士。</view>
        </block>
      </view>
    </scroll-view>

    <view wx:if="{{scalePreviewVisible}}" class="nutrition-assessment__scale-mask" catchtap="onCloseScalePreview">
      <view class="nutrition-assessment__scale-sheet" catchtap="onScaleSheetTap">
        <view class="nutrition-assessment__profile-title">调整整餐份量</view>
        <view class="nutrition-assessment__scale-summary">
          <view class="nutrition-assessment__scale-summary-item">
            <view class="nutrition-assessment__scale-summary-label">当前</view>
            <view class="nutrition-assessment__scale-summary-value">{{viewAssessment.energy.scaleSuggestion.currentTotalGramText}} / {{viewAssessment.energy.currentKcalText}}</view>
          </view>
          <view class="nutrition-assessment__scale-summary-item">
            <view class="nutrition-assessment__scale-summary-label">建议</view>
            <view class="nutrition-assessment__scale-summary-value">约 {{viewAssessment.energy.scaleSuggestion.suggestedTotalGramText}} / {{viewAssessment.energy.scaleSuggestion.targetKcalText}}</view>
          </view>
        </view>
        <view class="nutrition-assessment__scale-list">
          <view wx:for="{{viewAssessment.energy.scaleSuggestion.suggestedIngredients}}" wx:key="name" class="nutrition-assessment__scale-row">
            <view>{{item.name}}</view>
            <view>{{item.currentGramText}} → {{item.suggestedGramText}}</view>
          </view>
        </view>
        <view class="nutrition-assessment__scale-note">食材比例不变，营养密度结论不变。</view>
        <view class="nutrition-assessment__profile-actions">
          <ui-button variant="secondary" bind:tap="onCloseScalePreview">取消</ui-button>
          <ui-button bind:tap="onConfirmScalePreview">确认调整</ui-button>
        </view>
      </view>
    </view>

    <view wx:if="{{profileSelectorVisible}}" class="nutrition-assessment__profile-mask" catchtap="onCloseProfileSelector">
      <view class="nutrition-assessment__profile-sheet" catchtap="onProfileSheetTap">
        <view class="nutrition-assessment__profile-title">{{profileSelectorTitle}}</view>
        <view class="nutrition-assessment__profile-description">系统会根据狗狗档案推荐，本次修改只影响当前食谱。</view>
        <view wx:for="{{profileOptions}}" wx:key="code" class="nutrition-assessment__profile-option {{pendingProfileCode === item.code ? 'nutrition-assessment__profile-option--active' : ''}}" data-code="{{item.code}}" bindtap="onSelectProfile">
          <view class="nutrition-assessment__profile-radio"></view>
          <view><view class="nutrition-assessment__profile-name">{{item.name}}</view><view wx:if="{{item.recommended}}" class="nutrition-assessment__profile-recommended">系统推荐</view></view>
        </view>
        <view class="nutrition-assessment__profile-actions">
          <ui-button variant="secondary" bind:tap="onCloseProfileSelector">取消</ui-button>
          <ui-button bind:tap="onApplyProfile">应用</ui-button>
        </view>
      </view>
    </view>
  </view>
</view>
