@import "../../styles/tokens.wxss";

.recipe-card {
  display: block;
}

.recipe-card__inner {
  display: flex;
  height: 180rpx;
  overflow: hidden;
}

.recipe-card__thumb {
  width: 240rpx;
  height: 180rpx;
  flex: 0 0 240rpx;
  background: var(--df-color-surface-muted);
  border-right: 1rpx solid var(--df-color-line);
  overflow: hidden;
}

.recipe-card__thumb-image {
  width: 100%;
  height: 100%;
  display: block;
}

.recipe-card__body {
  min-width: 0;
  flex: 1;
  padding: 18rpx 22rpx 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.recipe-card__title-row {
  min-width: 0;
}

.recipe-card__name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--df-color-text);
}

.recipe-card__desc,
.recipe-card__ingredients {
  margin-top: 7rpx;
  color: var(--df-color-muted);
  line-height: 1.35;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  max-height: 38rpx;
  overflow: hidden;
}
