@import "../../styles/tokens.wxss";

:host {
  display: block;
}

.nutrition-assessment {
  color: var(--df-color-text);
}

.nutrition-assessment__summary {
  min-height: 232rpx;
  box-sizing: border-box;
  padding: var(--df-space-3) var(--df-space-4) var(--df-space-5);
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-xl);
  background: var(--df-color-surface);
}

.nutrition-assessment__summary--pressed {
  background: var(--df-color-surface-pressed);
}

.nutrition-assessment__handle {
  width: 124rpx;
  height: 8rpx;
  margin: 0 auto var(--df-space-4);
  border-radius: var(--df-radius-pill);
  background: var(--df-color-line);
}

.nutrition-assessment__summary-head,
.nutrition-assessment__standard-head,
.nutrition-assessment__expanded-head,
.nutrition-assessment__elements-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-4);
}

.nutrition-assessment__summary-heading,
.nutrition-assessment__standard-title,
.nutrition-assessment__expanded-title,
.nutrition-assessment__elements-heading,
.nutrition-assessment__missing-heading {
  font-size: var(--df-font-lg);
  font-weight: 800;
}

.nutrition-assessment__summary-link,
.nutrition-assessment__profile-link,
.nutrition-assessment__elements-arrow {
  min-height: var(--df-touch-min);
  display: flex;
  align-items: center;
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
  font-weight: 700;
  text-align: right;
}

.nutrition-assessment__summary-status {
  margin-top: var(--df-space-1);
  color: var(--df-color-status-low);
  font-size: var(--df-font-md);
  font-weight: 800;
}

.nutrition-assessment__summary-status--suitable {
  color: var(--df-color-primary);
}

.nutrition-assessment__summary-status--unavailable {
  color: var(--df-color-muted);
}

.nutrition-assessment__summary-advice {
  margin-top: var(--df-space-2);
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.nutrition-assessment__expanded {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: var(--df-color-surface);
}

.nutrition-assessment__scroll {
  height: 100%;
}

.nutrition-assessment__expanded-content {
  box-sizing: border-box;
  padding: var(--df-space-5) var(--df-space-6) calc(var(--df-space-6) + env(safe-area-inset-bottom));
}

.nutrition-assessment__expanded-context,
.nutrition-assessment__basis,
.nutrition-assessment__standard-source,
.nutrition-assessment__conclusion-counts,
.nutrition-assessment__elements-description,
.nutrition-assessment__contributors,
.nutrition-assessment__profile-description,
.nutrition-assessment__profile-recommended,
.nutrition-assessment__disclaimer {
  color: var(--df-color-muted);
  font-size: var(--df-font-xs);
  line-height: 1.5;
}

.nutrition-assessment__basis {
  margin-top: var(--df-space-2);
}

.nutrition-assessment__collapse {
  min-width: var(--df-touch-min);
  min-height: var(--df-touch-min);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--df-space-3);
  border: 1rpx solid var(--df-color-line-strong);
  border-radius: var(--df-radius-lg);
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
  font-weight: 700;
}

.nutrition-assessment__collapse--pressed {
  background: var(--df-color-surface-pressed);
}

.nutrition-assessment__loading {
  margin-top: var(--df-space-6);
  padding: var(--df-space-6);
  color: var(--df-color-muted);
  text-align: center;
}

.nutrition-assessment__conclusion {
  margin-top: var(--df-space-5);
  padding: var(--df-space-5);
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-lg);
  background: var(--df-color-surface);
}

.nutrition-assessment__conclusion-label {
  color: var(--df-color-muted);
  font-size: var(--df-font-xs);
}

.nutrition-assessment__conclusion-status {
  margin-top: var(--df-space-1);
  color: var(--df-color-status-low);
  font-size: var(--df-font-xl);
  font-weight: 800;
}

.nutrition-assessment__conclusion-status--suitable {
  color: var(--df-color-primary);
}

.nutrition-assessment__conclusion-status--unavailable {
  color: var(--df-color-muted);
}

.nutrition-assessment__conclusion-advice {
  margin-top: var(--df-space-2);
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.nutrition-assessment__conclusion-counts {
  margin-top: var(--df-space-2);
}

.nutrition-assessment__standard {
  margin-top: var(--df-space-6);
  padding-top: var(--df-space-5);
  border-top: 1rpx solid var(--df-color-line);
}

.nutrition-assessment__standard-source {
  margin-top: var(--df-space-1);
}

.nutrition-assessment__item {
  margin-top: var(--df-space-4);
  padding: var(--df-space-4) 0 var(--df-space-4) var(--df-space-5);
  border-left: 6rpx solid var(--df-color-status-low);
}

.nutrition-assessment__item--high {
  border-left-color: var(--df-color-warning);
}

.nutrition-assessment__item-title {
  color: var(--df-color-status-low);
  font-size: var(--df-font-md);
  font-weight: 800;
}

.nutrition-assessment__item--high .nutrition-assessment__item-title {
  color: var(--df-color-warning);
}

.nutrition-assessment__item-value,
.nutrition-assessment__missing-item {
  margin: var(--df-space-2) 0;
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.nutrition-assessment__contributors {
  margin-bottom: var(--df-space-3);
}

.nutrition-assessment__met,
.nutrition-assessment__unavailable {
  margin-top: var(--df-space-4);
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
}

.nutrition-assessment__unavailable {
  color: var(--df-color-muted);
}

.nutrition-assessment__elements-entry {
  min-height: var(--df-touch-min);
  margin-top: var(--df-space-6);
  padding: var(--df-space-4) 0;
  border-top: 1rpx solid var(--df-color-line);
}

.nutrition-assessment__filters {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--df-space-1);
  padding: var(--df-space-1);
  border-radius: var(--df-radius-md);
  background: var(--df-color-surface-muted);
}

.nutrition-assessment__filter {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--df-radius-sm);
  color: var(--df-color-muted);
  font-size: var(--df-font-xs);
}

.nutrition-assessment__filter--active {
  color: var(--df-color-primary);
  background: var(--df-color-surface);
  font-weight: 800;
}

.nutrition-assessment__table-scroll {
  margin-top: var(--df-space-4);
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-md);
}

.nutrition-assessment__table {
  width: 940rpx;
}

.nutrition-assessment__table-row {
  display: grid;
  grid-template-columns: 190rpx 180rpx 260rpx 310rpx;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--df-color-line);
}

.nutrition-assessment__table-row:last-child {
  border-bottom: 0;
}

.nutrition-assessment__table-row--head {
  min-height: 72rpx;
  background: var(--df-color-surface-muted);
  font-weight: 800;
}

.nutrition-assessment__table-cell {
  box-sizing: border-box;
  padding: var(--df-space-3);
  border-left: 1rpx solid var(--df-color-line);
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-xs);
  line-height: 1.4;
}

.nutrition-assessment__table-cell:first-child {
  border-left: 0;
}

.nutrition-assessment__table-cell--name {
  color: var(--df-color-text);
  font-weight: 700;
}

.nutrition-assessment__table-status--met {
  color: var(--df-color-primary);
}

.nutrition-assessment__table-status--low {
  color: var(--df-color-status-low);
}

.nutrition-assessment__table-status--high {
  color: var(--df-color-warning);
}

.nutrition-assessment__missing {
  margin-top: var(--df-space-5);
  padding: var(--df-space-5);
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-lg);
}

.nutrition-assessment__missing-note {
  color: var(--df-color-status-low);
  font-size: var(--df-font-sm);
  font-weight: 700;
}

.nutrition-assessment__retry {
  margin-top: var(--df-space-4);
}

.nutrition-assessment__disclaimer {
  margin-top: var(--df-space-6);
  padding-bottom: var(--df-space-6);
}

.nutrition-assessment__profile-mask {
  position: absolute;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: var(--df-color-mask);
}

.nutrition-assessment__profile-sheet {
  width: 100%;
  max-height: 78vh;
  box-sizing: border-box;
  padding: var(--df-space-6) var(--df-space-6) calc(var(--df-space-6) + env(safe-area-inset-bottom));
  border-radius: var(--df-radius-xl) var(--df-radius-xl) 0 0;
  background: var(--df-color-surface);
  overflow-y: auto;
}

.nutrition-assessment__profile-title {
  font-size: var(--df-font-lg);
  font-weight: 800;
}

.nutrition-assessment__profile-description {
  margin: var(--df-space-2) 0 var(--df-space-4);
}

.nutrition-assessment__profile-option {
  min-height: 112rpx;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  gap: var(--df-space-4);
  margin-top: var(--df-space-3);
  padding: var(--df-space-3) var(--df-space-4);
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-lg);
}

.nutrition-assessment__profile-option--active {
  border-color: var(--df-color-primary);
}

.nutrition-assessment__profile-radio {
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  flex: 0 0 auto;
  border: 2rpx solid var(--df-color-line-strong);
  border-radius: var(--df-radius-pill);
}

.nutrition-assessment__profile-option--active .nutrition-assessment__profile-radio {
  border: 10rpx solid var(--df-color-primary);
}

.nutrition-assessment__profile-name {
  font-size: var(--df-font-md);
  font-weight: 700;
}

.nutrition-assessment__profile-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--df-space-4);
  margin-top: var(--df-space-5);
}
