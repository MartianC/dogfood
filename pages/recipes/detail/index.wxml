<view wx:if="{{recipe}}" class="page with-bottom-action">
  <image class="detail-cover" src="{{recipe.imageUrl || defaultRecipeImage}}" mode="aspectFill" />
  <view class="detail-head">
    <view class="title">{{recipe.title}}</view>
    <view class="tag-list">
      <text wx:for="{{recipe.tags}}" wx:key="*this" class="tag good">{{item}}</text>
      <text class="tag">{{recipe.cookingTimeMinutes}} 分钟</text>
    </view>
    <view class="subtitle">{{recipe.description}}</view>
  </view>

  <view wx:if="{{warnings.length}}" class="section">
    <risk-badge warnings="{{warnings}}" />
  </view>

  <view class="section card">
    <view class="section-title">食材比例</view>
    <view wx:for="{{recipe.ingredients}}" wx:key="name" class="ratio-row">
      <text>{{item.name}}</text>
      <text>{{item.ratioPercent}}%</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">制作步骤</view>
    <view wx:for="{{recipe.steps}}" wx:key="*this" class="step-row">
      <text class="step-num">{{index + 1}}</text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="section notice">食谱详情只展示通用比例，选择制作周期后再按狗狗体重和每日餐数换算克重。</view>

  <view class="bottom-action">
    <button class="button {{hasDanger ? 'warning' : ''}}" bindtap="onChoosePeriod">{{hasDanger ? '仍然选择周期' : '选择制作周期'}}</button>
  </view>

  <view wx:if="{{showAuthSheet}}" class="modal-mask" bindtap="onCloseAuthSheet">
    <view class="sheet" catchtap="noop">
      <view class="eyebrow">生成专属清单</view>
      <view class="sheet-title">先添加狗狗档案</view>
      <view class="sheet-desc">添加后会按狗狗体重、每日餐数和制作周期换算总量，并提醒过敏或忌口食材。</view>
      <button class="button" bindtap="onAuthAndCreate">微信登录并添加狗狗</button>
    </view>
  </view>
</view>
