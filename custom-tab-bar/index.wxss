@import "../styles/tokens.wxss";

:host {
  display: block;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background-color: var(--df-color-surface);
  overflow: visible;
  pointer-events: none;
  --td-brand-color: var(--df-color-primary);
  --td-brand-color-active: var(--df-color-primary-pressed);
  --td-brand-color-light: var(--df-color-primary-soft);
  --td-brand-color-light-active: var(--df-color-primary-soft-pressed);
  --td-button-primary-bg-color: var(--df-color-primary);
  --td-button-primary-border-color: var(--df-color-primary);
  --td-button-primary-active-bg-color: var(--df-color-primary-pressed);
  --td-button-primary-active-border-color: var(--df-color-primary-pressed);
  --td-button-primary-color: var(--df-color-on-primary);
  --td-fab-shadow: var(--df-shadow-primary);
}

.app-tab-bar {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 112rpx;
  margin: 0;
  background-color: var(--df-color-surface);
  pointer-events: auto;
}

.app-tab-bar__icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.app-tab-bar__fab-label {
  position: absolute;
  left: 50%;
  bottom: calc(20rpx + var(--df-tab-bar-safe-area-bottom));
  z-index: 2;
  transform: translateX(-50%);
  color: var(--df-color-primary);
  font-size: 22rpx;
  line-height: 32rpx;
  white-space: nowrap;
  pointer-events: none;
}
