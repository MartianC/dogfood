.share-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #e3f0e8;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  color: #6f7b73;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.button {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #25684a;
  color: #ffffff;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.button::after {
  border: 0;
}

.button.secondary {
  background: #ffffff;
  color: #34423a;
  border: 1rpx solid #b7c7bc;
}
