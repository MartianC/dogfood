@import "../../../styles/tokens.wxss";

.weight-page {
  padding-top: 0;
}

.weight-page__heading {
  padding: 8rpx 0 4rpx;
}

.weight-page__description,
.weight-section__description,
.weight-chart-summary__label,
.weight-history-item__date,
.weight-current__source {
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 1.45;
}

.weight-page__description {
  margin-top: var(--df-space-2);
}

.weight-dog-switcher,
.weight-section {
  margin-top: var(--df-space-5);
}

.weight-picker-value {
  min-height: 58rpx;
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  line-height: 58rpx;
}

.weight-page__status {
  margin-top: 96rpx;
  text-align: center;
}

.weight-page__status-title {
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  font-weight: 800;
}

.weight-page__status-description {
  margin-top: var(--df-space-2);
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.weight-page__status-action {
  margin-top: var(--df-space-5);
}

.weight-page__empty-dog {
  margin-top: 72rpx;
}

.weight-current {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-2);
}

.weight-current__eyebrow {
  color: var(--df-color-on-primary-muted);
  font-size: var(--df-font-sm);
}

.weight-current__value {
  color: var(--df-color-on-primary);
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  line-height: 1.1;
}

.weight-current__date {
  color: var(--df-color-on-primary);
  font-size: var(--df-font-sm);
  line-height: 1.4;
}

.weight-current__source {
  color: var(--df-color-on-primary-muted);
  font-size: var(--df-font-xs);
}

.weight-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-3);
  margin-bottom: var(--df-space-3);
}

.weight-section__title {
  color: var(--df-color-text);
  font-size: var(--df-font-lg);
  font-weight: 800;
  line-height: 1.3;
}

.weight-section__description {
  margin-top: var(--df-space-1);
  font-size: var(--df-font-xs);
}

.weight-chart-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--df-space-3);
}

.weight-chart-summary__label {
  min-width: 0;
  overflow-wrap: anywhere;
}

.weight-chart-summary__range {
  flex: none;
  color: var(--df-color-primary);
  font-size: var(--df-font-sm);
  font-weight: 800;
}

.weight-chart {
  position: relative;
  height: 300rpx;
  margin: 40rpx 12rpx 0;
  border-left: 1rpx solid var(--df-color-line-strong);
  border-bottom: 1rpx solid var(--df-color-line-strong);
  background: var(--df-color-surface-muted);
}

.weight-chart__grid {
  position: absolute;
  right: 0;
  left: 0;
  border-top: 1rpx dashed var(--df-color-line);
}

.weight-chart__grid--top {
  top: 0;
}

.weight-chart__grid--middle {
  top: 50%;
}

.weight-chart__grid--bottom {
  bottom: 0;
}

.weight-chart__segment {
  position: absolute;
  z-index: 1;
  height: 5rpx;
  transform-origin: left center;
  border-radius: var(--df-radius-pill);
  background: var(--df-color-primary);
}

.weight-chart__point {
  position: absolute;
  z-index: 2;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
  border: 5rpx solid var(--df-color-primary);
  border-radius: var(--df-radius-pill);
  background: var(--df-color-surface);
}

.weight-chart__point--latest {
  width: 34rpx;
  height: 34rpx;
  border-width: 7rpx;
  box-shadow: 0 0 0 8rpx var(--df-color-primary-soft);
}

.weight-chart-axis {
  display: flex;
  justify-content: space-between;
  margin: var(--df-space-2) 12rpx 0;
  color: var(--df-color-muted);
  font-size: var(--df-font-xs);
}

.weight-history-section {
  padding-bottom: 32rpx;
}

.weight-history-list {
  display: grid;
  gap: var(--df-space-3);
}

.weight-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-3);
  min-height: var(--df-touch-min);
}

.weight-history-item__main {
  min-width: 0;
  flex: 1;
}

.weight-history-item__heading {
  display: flex;
  align-items: center;
  gap: var(--df-space-2);
  color: var(--df-color-text);
  font-size: var(--df-font-lg);
  font-weight: 800;
}

.weight-history-item__date {
  margin-top: var(--df-space-1);
}

.weight-history-item__change {
  margin-top: var(--df-space-1);
  color: var(--df-color-primary);
  font-size: var(--df-font-xs);
  line-height: 1.4;
}

.weight-history-more {
  margin-top: var(--df-space-4);
}
