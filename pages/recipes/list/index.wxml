<view class="page">
  <view class="search">
    <input placeholder="搜索食材或食谱名称" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="filter-card">
    <picker range="{{modeOptions}}" range-key="label" value="{{modeIndex}}" bindchange="onMode">
      <view class="picker-row">
        <text>筛选方式</text>
        <text>{{modeOptions[modeIndex].label}}</text>
      </view>
    </picker>

    <picker wx:if="{{modeOptions[modeIndex].value === 'singleDog'}}" range="{{dogs}}" range-key="name" value="{{dogIndex}}" bindchange="onDog">
      <view class="picker-row">
        <text>选择狗狗</text>
        <text>{{dogs[dogIndex].name}}</text>
      </view>
    </picker>

    <view wx:if="{{modeOptions[modeIndex].value === 'custom'}}" class="custom-filter">
      <picker range="{{ageOptions}}" range-key="label" value="{{ageIndex}}" bindchange="onAge">
        <view class="small-picker">年龄：{{ageIndex >= 0 ? ageOptions[ageIndex].label : '不限'}}</view>
      </picker>
      <picker range="{{goalOptions}}" range-key="label" value="{{goalIndex}}" bindchange="onGoal">
        <view class="small-picker">功能：{{goalIndex >= 0 ? goalOptions[goalIndex].label : '不限'}}</view>
      </picker>
      <picker range="{{allergenOptions}}" range-key="label" value="{{allergenIndex}}" bindchange="onAllergen">
        <view class="small-picker">过敏：{{allergenIndex >= 0 ? '避开' + allergenOptions[allergenIndex].label : '不限'}}</view>
      </picker>
    </view>
  </view>

  <view class="notice good" bindtap="onCustomRecipe">有现成食材？创建自定义食谱，按狗狗档案检查是否合适。</view>

  <view class="section stack">
    <recipe-card wx:for="{{filteredRecipes}}" wx:key="id" recipe="{{item}}" showFit="{{authState === 'has-profile'}}" bind:taprecipe="onRecipeTap" />
  </view>
</view>
