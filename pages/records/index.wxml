<view class="page with-tab-bar records-page">
  <view class="records-calendar-shell">
    <record-calendar
      value="{{selectedDateKey}}"
      calendarDays="{{calendarDays}}"
      loading="{{loading}}"
      bind:select="onCalendarSelect"
      bind:panelchange="onCalendarPanelChange"
    />
  </view>

  <view wx:if="{{loadStatus !== 'idle'}}" class="records-day">
    <block wx:if="{{loadStatus === 'loading'}}">
      <view class="records-day__heading">正在读取 {{activeMonthText}}记录</view>
      <view class="records-day__description">完成后会显示每天的打卡状态</view>
    </block>

    <block wx:elif="{{loadStatus === 'error'}}">
      <view class="records-day__heading">{{activeMonthText}}记录暂时加载失败</view>
      <view class="records-day__description">{{errorText}}</view>
      <view class="records-day__action"><ui-button bind:tap="onRetryMonth">重新加载</ui-button></view>
    </block>

    <block wx:elif="{{!monthHasRecords}}">
      <view class="records-day__heading">{{activeMonthText}}还没有喂食记录</view>
      <view class="records-day__description">保存第一顿后，日历会显示每天的打卡情况</view>
      <view class="records-day__action"><ui-button bind:tap="onCreateMeal">记录第一顿</ui-button></view>
    </block>

    <block wx:else>
      <view class="records-day__heading">{{selectedDateHeading}}</view>
      <view class="records-day__description">{{selectedDateDescription}}</view>

      <view wx:if="{{selectedRecords.length}}" class="records-list">
        <ui-card wx:for="{{selectedRecords}}" wx:key="id" padding="large">
          <view class="records-entry" data-id="{{item.id}}" aria-role="button" aria-label="查看{{item.dogName}}的本餐记录" bindtap="onOpenRecord">
            <view class="records-entry__content">
              <view class="records-entry__heading">{{item.timeText}} · {{item.dogName}}</view>
              <view class="records-entry__summary">{{item.menuText}} · {{item.ingredientCount}} 种狗饭食材</view>
            </view>
            <view class="records-entry__chevron" aria-hidden="true">›</view>
          </view>
        </ui-card>
      </view>

      <view wx:else class="records-day__empty">这一天还没有喂食记录</view>
    </block>
  </view>
</view>
