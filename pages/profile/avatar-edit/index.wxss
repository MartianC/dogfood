@import "../../../styles/tokens.wxss";

.avatar-editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  background: var(--df-color-bg);
}

.avatar-editor__intro {
  padding: 0 8rpx;
  text-align: center;
}

.avatar-editor__heading {
  color: var(--df-color-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.avatar-editor__description {
  margin-top: 12rpx;
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.avatar-editor__canvas-wrap {
  position: relative;
  margin: 48rpx auto 0;
  overflow: hidden;
  border-radius: var(--df-radius-xl);
  background: var(--df-color-surface-muted);
  box-shadow: var(--df-shadow-card);
}

.avatar-editor__canvas {
  display: block;
}

.avatar-editor__crop-frame {
  position: absolute;
  inset: 0;
  border: 2rpx solid var(--df-color-on-primary);
  box-sizing: border-box;
  pointer-events: none;
}

.avatar-editor__crop-line {
  position: absolute;
  background: var(--df-color-on-primary);
  opacity: 0.46;
}

.avatar-editor__crop-line--vertical {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1rpx;
}

.avatar-editor__crop-line--horizontal {
  top: 50%;
  right: 0;
  left: 0;
  height: 1rpx;
}

.avatar-editor__controls {
  margin: 44rpx auto 0;
  max-width: 640rpx;
  padding: 0 8rpx;
}

.avatar-editor__scale-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--df-color-text-secondary);
  font-size: var(--df-font-sm);
  line-height: 1.4;
}

.avatar-editor__scale-label text:last-child {
  color: var(--df-color-muted);
  font-variant-numeric: tabular-nums;
}

.avatar-editor__slider {
  margin: 18rpx 0 0;
}

.avatar-editor__action {
  padding-top: 20rpx;
}
