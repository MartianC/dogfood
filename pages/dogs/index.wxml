<view class="page with-tab-bar dogs-page" aria-label="狗狗档案中心">
  <view wx:if="{{authState === 'guest'}}" class="section guest-panel">
    <ui-card>
      <view class="panel-title">登录后管理狗狗档案</view>
      <view class="panel-desc">开始记录本餐前，需要先登录并添加狗狗档案。</view>
      <view class="panel-action">
        <ui-button bind:tap="onLogin">微信登录并添加狗狗</ui-button>
      </view>
    </ui-card>
  </view>

  <view wx:else class="section">
    <view class="section-head">
      <view class="df-heading-lg">狗狗档案</view>
      <view class="section-action" bindtap="onAddDog">新增</view>
    </view>
    <view wx:if="{{dogs.length}}" class="profile-dog-list">
      <view
        wx:for="{{dogs}}"
        wx:key="id"
        class="dog-card"
        data-id="{{item.id}}"
        bindtap="onEditDogPanel"
      >
        <ui-card>
          <view class="dog-panel">
            <image class="dog-avatar" src="{{item.avatarUrl || defaultDogAvatar}}" mode="aspectFill" />
            <view class="dog-copy">
              <view class="dog-panel-head">
                <text>{{item.name}}</text>
                <text class="edit-link">修改</text>
              </view>
              <view class="dog-meta">{{item.lifeStageLabel || '档案待完善'}}｜{{item.weightKg > 0 ? item.weightKg + 'kg' : '体重未记录'}}｜每日 {{item.dailyMeals}} 餐｜{{dietGoalLabels[item.dietGoal] || '日常'}}饮食</view>
              <view class="dog-panel__actions">
                <ui-button
                  size="small"
                  block="{{false}}"
                  variant="ghost"
                  data-id="{{item.id}}"
                  catch:tap="onViewWeight"
                >{{item.weightKg > 0 ? '查看体重趋势' : '记录第一次体重'}}</ui-button>
                <ui-button
                  size="small"
                  block="{{false}}"
                  variant="ghost"
                  data-id="{{item.id}}"
                  catch:tap="onViewCare"
                >护理记录</ui-button>
              </view>
            </view>
          </view>
        </ui-card>
      </view>
    </view>
    <empty-state wx:else title="还没有狗狗档案" description="先添加一只狗狗，生成清单时会自动换算份量。" actionText="添加狗狗" image-url="{{defaultDogAvatar}}" bind:action="onAddDog" />
  </view>
</view>
