{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanRecipeProjectionStagingReport/v1",
  "type": "object",
  "required": [
    "$schema",
    "releaseId",
    "counts",
    "samples",
    "policyStatusDistribution",
    "blockedReasons",
    "versions",
    "versionChecksum",
    "rollbackCandidate",
    "activation"
  ],
  "properties": {
    "$schema": {
      "const": "humanRecipeProjectionStagingReport/v1"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "required": [
        "recipes",
        "sourceIngredients",
        "mappedIngredients",
        "unmappedIngredients",
        "nonBlockedComponents",
        "blockedComponents"
      ],
      "properties": {
        "recipes": { "type": "integer", "minimum": 0 },
        "sourceIngredients": { "type": "integer", "minimum": 0 },
        "mappedIngredients": { "type": "integer", "minimum": 0 },
        "unmappedIngredients": { "type": "integer", "minimum": 0 },
        "nonBlockedComponents": { "type": "integer", "minimum": 0 },
        "blockedComponents": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "policyStatusDistribution": {
      "type": "object",
      "required": [
        "allowed",
        "conditional",
        "unknown",
        "blocked"
      ],
      "properties": {
        "allowed": { "type": "integer", "minimum": 0 },
        "conditional": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blockedReasons": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "releaseId",
        "recipeVersion",
        "mappingVersion",
        "catalogVersion",
        "policyVersion"
      ],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "recipeVersion": { "type": ["string", "null"] },
        "mappingVersion": { "type": ["string", "null"] },
        "catalogVersion": { "type": ["string", "null"] },
        "policyVersion": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "versionChecksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollbackCandidate": {
      "type": "object",
      "required": ["status", "recipeVersion"],
      "properties": {
        "status": { "const": "requires-active-pointer" },
        "recipeVersion": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "required": ["targetStatus", "productionActiveSwitchAllowed"],
      "properties": {
        "targetStatus": { "const": "staging" },
        "productionActiveSwitchAllowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
