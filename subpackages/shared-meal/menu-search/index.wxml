<view class="page shared-meal-menu-page">
  <recipe-ingredient-search
    value="{{searchValue}}"
    loading="{{loading}}"
    placeholder="今天大人们吃什么菜？"
    action-text="取消"
    bind:change="onSearchChange"
    bind:action="onSearchAction"
  />

  <ui-notice wx:if="{{errorText && errorScope === 'initial'}}" variant="warning">
    <view class="shared-meal-menu-initial-error">
      <text>{{errorText}}</text>
      <ui-button
        variant="ghost"
        size="small"
        block="{{false}}"
        bind:tap="retryInitialSearch"
      >重新加载</ui-button>
    </view>
  </ui-notice>

  <view class="shared-meal-menu-results">
    <block wx:if="{{loading}}">
      <recipe-menu-indicator
        kind="loading"
        text="正在读取已发布菜谱"
      />
    </block>

    <block wx:elif="{{!recipes.length && !errorText}}">
      <ui-empty
        title="没有找到菜谱"
        description="换个菜名或原料关键词试试"
      />
    </block>

    <block wx:else>

      <ui-card padding="none">
        <view class="shared-meal-menu-result-list">
          <view
            wx:for="{{recipes}}"
            wx:key="id"
            class="shared-meal-menu-result"
          >
            <view class="shared-meal-menu-result__top">
              <view
                class="shared-meal-menu-result__selection"
                data-recipe-id="{{item.id}}"
                catchtap="onToggleRecipeSelection"
                aria-label="{{item.isSelected ? '取消选择' : '选择'}}{{item.title}}"
              >
                <recipe-menu-indicator kind="checkbox" checked="{{item.isSelected}}" />
              </view>
              <view class="shared-meal-menu-result__content">
                <view class="shared-meal-menu-result__name">{{item.title}}</view>
                <view
                  class="shared-meal-menu-result__summary"
                  data-recipe-id="{{item.id}}"
                  catchtap="onToggleRecipeExpansion"
                  aria-role="button"
                  aria-expanded="{{item.isExpanded}}"
                  aria-label="{{item.isExpanded ? '收起' : '展开'}}{{item.title}}原料"
                >
                  <text class="shared-meal-menu-result__meta">{{item.mappingSummary}}</text>
                  <recipe-menu-indicator kind="icon" icon="{{item.isExpanded ? 'chevron-down' : 'chevron-right'}}" />
                </view>
              </view>
            </view>

            <view wx:if="{{item.isExpanded}}" class="shared-meal-menu-result__detail">
              <block wx:if="{{item.detailLoading}}">
                <recipe-menu-indicator kind="loading" text="正在读取原料" />
              </block>

              <block wx:elif="{{item.detailError}}">
                <view class="shared-meal-menu-detail-error">
                  <text>原料详情暂时没加载出来</text>
                  <ui-button
                    variant="ghost"
                    size="small"
                    block="{{false}}"
                    data-recipe-id="{{item.id}}"
                    bind:tap="onRetryRecipeDetail"
                  >重试</ui-button>
                </view>
              </block>

              <block wx:else>
                <view class="shared-meal-menu-detail-groups">
                  <view class="shared-meal-menu-detail-group">
                    <text class=" shared-meal-menu-detail-group__label--allowed">狗狗可以吃</text>
                    <text class="shared-meal-menu-detail-group__value">{{item.allowedIngredientText}}</text>
                  </view>
                  <view class="shared-meal-menu-detail-group">
                    <text class="shared-meal-menu-detail-group__label shared-meal-menu-detail-group__label--blocked">狗狗不能吃</text>
                    <text class="shared-meal-menu-detail-group__value">{{item.blockedIngredientText}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </ui-card>

      <view wx:if="{{loadingMore}}" class="shared-meal-menu-pagination">
        <recipe-menu-indicator kind="loading" text="正在加载更多菜谱" />
      </view>

      <view
        wx:if="{{errorText && errorScope === 'more'}}"
        class="shared-meal-menu-pagination-error"
      >
        <view class="shared-meal-menu-pagination-error__copy">
          <text class="shared-meal-menu-pagination-error__title">
            后面的菜单暂时没加载出来
          </text>
          <text class="shared-meal-menu-pagination-error__description">
            已加载结果和已选菜单已保留
          </text>
        </view>
        <ui-button
          variant="ghost"
          size="medium"
          block="{{false}}"
          bind:tap="retryLoadMore"
        >重试</ui-button>
      </view>
    </block>
  </view>

  <view class="shared-meal-menu-selection-summary">
    <view class="shared-meal-menu-selection-summary__title">
      {{selectedRecipes.length ? '已选 ' + selectedRecipes.length + ' 道菜' : '还没有选择菜单'}}
    </view>

    <block wx:if="{{selectedRecipes.length}}">
      <scroll-view
        class="shared-meal-menu-selection-summary__tags"
        scroll-x
        enable-flex
        enhanced
        show-scrollbar="{{false}}"
      >
        <view
          wx:for="{{selectedRecipes}}"
          wx:key="id"
          class="shared-meal-menu-selection-summary__tag"
        >
          <ui-tag
            variant="good"
            size="large"
            removable
            event-value="{{item.id}}"
            bind:remove="onRemoveSelectedRecipe"
          >{{item.title}}</ui-tag>
        </view>
      </scroll-view>
    </block>
    <block wx:else>
      <view class="shared-meal-menu-selection-summary__hint">
        至少选择 1 道菜后才能继续
      </view>
    </block>

    <view wx:if="{{errorText && errorScope === 'confirm'}}" class="shared-meal-menu-selection-summary__error">
      {{errorText}}
    </view>

    <view class="shared-meal-menu-selection-summary__confirm">
      <ui-button
        size="medium"
        disabled="{{!selectedRecipes.length || loading || confirming}}"
        loading="{{confirming}}"
        bind:tap="onConfirm"
      >选好菜单，继续</ui-button>
    </view>
  </view>
</view>
