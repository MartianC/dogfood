<view class="app-tab-bar" style="{{tabBarContainerStyle}}">
  <t-tab-bar
    value="{{selected}}"
    theme="normal"
    shape="normal"
    fixed="{{false}}"
    split="{{false}}"
    bordered="{{true}}"
    safe-area-inset-bottom="{{true}}"
    custom-style="{{tabBarStyle}}"
    bind:change="onChange"
  >
    <block wx:for="{{items}}" wx:key="value">
      <t-tab-bar-item
        value="{{item.value}}"
        custom-style="{{tabItemStyle}}"
        aria-label="{{item.label}}"
      >
        <image
          slot="icon"
          class="app-tab-bar__icon"
          src="{{selected === item.value ? item.selectedIconPath : item.iconPath}}"
          mode="aspectFit"
        />
        {{item.label}}
      </t-tab-bar-item>
      <view wx:if="{{index === 1}}" style="{{tabBarGapStyle}}" aria-hidden="true" />
    </block>
  </t-tab-bar>
  <t-fab
    icon="add"
    text=""
    button-props="{{fabButtonProps}}"
    style="{{fabStyle}}"
    aria-label="记一顿"
    data-action-id="start-shared-meal"
    bind:click="onStartSharedMeal"
  />
  <view class="app-tab-bar__fab-label" aria-hidden="true">记一顿</view>
</view>
