<view class="page with-bottom-action shared-meal-route-menu-page">
  <recipe-ingredient-search
    value="{{searchValue}}"
    loading="{{loading}}"
    action-text="清空"
    bind:change="onSearchChange"
    bind:action="onSearchAction"
  />
  <ui-notice wx:if="{{errorText}}" variant="warning">{{errorText}}</ui-notice>

  <block wx:if="{{!selectedRecipe}}">
    <block wx:if="{{loading}}">
      <view class="shared-meal-route-menu-loading">正在读取已发布菜谱</view>
    </block>
    <block wx:elif="{{!recipes.length}}">
      <ui-empty title="没有找到菜谱" description="试试菜名或原料关键词" />
    </block>
    <block wx:else>
      <view class="shared-meal-route-menu-results">
        <view wx:for="{{recipes}}" wx:key="id" class="shared-meal-route-menu-result" data-index="{{index}}" bindtap="onSelectRecipe" aria-role="button" aria-label="查看{{item.title}}来源原料">
          <ui-card>
            <view class="shared-meal-route-menu-result__name">{{item.title}}</view>
            <view class="shared-meal-route-menu-result__meta">{{item.ingredients.length}} 项来源原料</view>
          </ui-card>
        </view>
      </view>
    </block>
  </block>

  <view wx:else class="shared-meal-route-menu-detail">
    <view class="shared-meal-route-menu-detail__name">{{selectedRecipe.title}}</view>
    <view class="shared-meal-route-menu-detail__hint">人饭分量只作来源参考；狗饭需要单独无调味制作。</view>
    <view wx:for="{{selectedRecipe.ingredients}}" wx:key="position" wx:for-item="item" class="shared-meal-route-menu-ingredient">
      <ui-card padding="small">
        <view class="shared-meal-route-menu-ingredient__source">
          <text>{{item.sourceText}}</text>
          <text wx:if="{{item.amountText}}" class="shared-meal-route-menu-ingredient__amount">{{item.amountText}}</text>
        </view>
        <view wx:if="{{!item.components.length}}" class="shared-meal-route-menu-ingredient__unmapped">未映射，仅保留来源文字</view>
        <view wx:for="{{item.components}}" wx:key="variantId" wx:for-item="component" wx:for-index="componentIndex" class="shared-meal-route-menu-component" data-ingredient-index="{{index}}" data-component-index="{{componentIndex}}" bindtap="onToggleComponent" aria-role="{{component.canSelect ? 'button' : 'text'}}" aria-disabled="{{!component.canSelect}}">
          <view class="shared-meal-route-menu-component__main">
            <text>{{component.displayName}}</text>
            <ui-tag variant="{{component.canSelect ? 'good' : 'warning'}}" size="small">{{component.canSelect ? (component.selected ? '已加入' : '未加入') : '不可共用'}}</ui-tag>
          </view>
          <view wx:if="{{!component.canSelect}}" class="shared-meal-route-menu-component__reason">{{component.blockedReason}}</view>
        </view>
      </ui-card>
    </view>
  </view>

  <view class="bottom-action">
    <ui-button disabled="{{!selectedRecipe || !selectedCount || loading}}" loading="{{loading}}" bind:tap="onConfirm">这顿就吃这些吧</ui-button>
  </view>
</view>
