<ui-card variant="{{advice.level === 'adjust' || advice.level === 'avoid' ? 'soft' : 'plain'}}">
  <view class="advice-card">
    <view class="advice-head">
      <view class="advice-name">{{advice.ingredientName}}</view>
      <ui-tag variant="{{advice.level === 'adjust' || advice.level === 'avoid' ? 'warning' : 'good'}}" size="small">{{advice.suggestion}}</ui-tag>
    </view>
    <view class="advice-reason">{{advice.reason}}</view>
  </view>
</ui-card>
