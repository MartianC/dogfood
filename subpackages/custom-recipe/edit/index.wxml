<view class="page recipe-design-page {{mode === 'edit' && ingredients.length ? 'recipe-design-page--editing' : ''}}">
  <view class="recipe-design-header">
    <view class="recipe-design-dog">{{targetDogName || '未选择狗狗'}}</view>
    <view class="recipe-design-heading df-heading-xl">{{title}}</view>
  </view>

  <block wx:if="{{mode === 'search'}}">
    <view class="section recipe-design-search">
      <recipe-ingredient-search value="{{searchValue}}" loading="{{searchLoading}}" bind:change="onSearchChange" />
    </view>
    <view class="recipe-design-section-heading">
      {{hasSearchQuery ? '搜索结果' : '常用与最近'}}
    </view>
    <block wx:if="{{!hasSearchQuery}}">
      <recipe-ingredient-list
        items="{{recentIngredients}}"
        mode="search"
        action-icon="/assets/icons/recipe-cart-filled.svg"
        bind:select="onSelectIngredient"
      />
      <view wx:if="{{!recentIngredients.length}}" class="recipe-design-search-empty">暂无最近添加的食材</view>
    </block>
    <block wx:elif="{{searchResults.length}}">
      <recipe-ingredient-list
        items="{{searchResults}}"
        mode="search"
        action-icon="/assets/icons/recipe-cart-filled.svg"
        bind:select="onSelectIngredient"
      />
    </block>
    <recipe-empty
      wx:elif="{{searchError}}"
      icon="search"
      title="搜索失败"
      description="请稍后重试"
      action-text="重试"
      bind:action="onRetrySearch"
    />
    <recipe-empty
      wx:elif="{{!searchLoading}}"
      icon="search"
      title="无结果"
      description="换个食材名称试试"
    />
    <view class="recipe-design-search-back">
      <ui-button variant="ghost" bind:tap="onCancelSearch">返回食谱</ui-button>
    </view>
  </block>

  <block wx:elif="{{!ingredients.length}}">
    <view class="recipe-design-empty">
      <recipe-empty
        icon="search"
        title="还没有添加食材"
        description="搜索食材并填写克重后，营养评估会自动更新。"
        action-text="新增食材"
        bind:action="onAddIngredient"
      />
    </view>
  </block>

  <block wx:else>
    <view class="recipe-design-editing-content">
      <scroll-view class="recipe-design-ingredient-scroll" scroll-y enable-flex>
        <view class="recipe-design-ingredient-scroll__content">
          <recipe-ingredient-list
            items="{{ingredientRows}}"
            mode="edit"
            action-icon="/assets/icons/recipe-delete-1-filled.svg"
            bind:amountchange="onIngredientAmountChange"
            bind:remove="onRemoveIngredient"
          />
          <view class="recipe-design-add-action">
            <ui-button variant="ghost" bind:tap="onAddIngredient">添加食材</ui-button>
          </view>
        </view>
      </scroll-view>

      <view class="recipe-design-summary-floating">
        <nutrition-assessment
          assessment="{{nutritionAssessment}}"
          loading="{{nutritionLoading}}"
          expanded="{{nutritionExpanded}}"
          bind:toggle="onNutritionToggle"
          bind:profilechange="onNutritionProfileChange"
          bind:nutrientselect="onNutritionNutrientSelect"
          bind:adjustingredients="onNutritionAdjustIngredients"
          bind:retry="onNutritionRetry"
        />
      </view>
    </view>

    <view class="bottom-action recipe-design-save-action">
      <ui-button bind:tap="onSaveRecipe">保存食谱</ui-button>
    </view>
  </block>

  <recipe-ingredient-popup
    visible="{{popupVisible}}"
    ingredient="{{selectedIngredient}}"
    bind:visiblechange="onPopupVisibleChange"
    bind:cancel="onPopupCancel"
    bind:confirm="onPopupConfirm"
  />
</view>
