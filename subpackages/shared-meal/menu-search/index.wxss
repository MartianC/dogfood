@import "../../../styles/tokens.wxss";

page {
  background: var(--df-color-bg);
}

.shared-meal-menu-page {
  display: flex;
  flex-direction: column;
  gap: var(--df-space-6);
  padding-bottom: calc(328rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(328rpx + env(safe-area-inset-bottom));
}

.shared-meal-menu-results {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--df-space-6);
}

.shared-meal-menu-results__heading {
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  font-weight: 600;
  line-height: 40rpx;
}

.shared-meal-menu-result-list {
  overflow: hidden;
  border-radius: var(--df-radius-lg);
}

.shared-meal-menu-result {
  min-width: 0;
  padding: 0 var(--df-space-5);
  border-bottom: 1rpx solid var(--df-color-line);
  background: var(--df-color-surface);
}

.shared-meal-menu-result:last-child {
  border-bottom: 0;
}

.shared-meal-menu-result__top {
  display: flex;
  min-width: 0;
  min-height: 108rpx;
  align-items: center;
  gap: var(--df-space-2);
}

.shared-meal-menu-result__selection {
  display: flex;
  width: var(--df-touch-min);
  min-width: var(--df-touch-min);
  height: var(--df-touch-min);
  align-items: center;
  justify-content: center;
}

.shared-meal-menu-result__content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.shared-meal-menu-result__name {
  overflow: hidden;
  color: var(--df-color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-meal-menu-result__summary {
  display: flex;
  min-width: 0;
  min-height: 56rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-2);
}

.shared-meal-menu-result__meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--df-color-muted);
  font-size: 26rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-meal-menu-result__detail {
  box-sizing: border-box;
  min-width: 0;
  margin: 0 0 var(--df-space-3);
  padding: var(--df-space-2) var(--df-space-3);
  border-radius: var(--df-radius-lg);
  background: var(--df-color-surface-muted);
}

.shared-meal-menu-detail-groups {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--df-space-1);
}

.shared-meal-menu-detail-group {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: var(--df-space-3);
  font-size: 26rpx;
  line-height: 36rpx;
}

.shared-meal-menu-detail-group__label {
  flex: 0 0 136rpx;
  font-weight: 600;
}

.shared-meal-menu-detail-group__label--allowed {
  color: var(--df-color-primary);
}

.shared-meal-menu-detail-group__label--blocked {
  color: var(--df-color-warning);
}

.shared-meal-menu-detail-group__value {
  min-width: 0;
  flex: 1;
  color: var(--df-color-muted);
  overflow-wrap: anywhere;
}

.shared-meal-menu-detail-error,
.shared-meal-menu-initial-error,
.shared-meal-menu-pagination-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--df-space-4);
}

.shared-meal-menu-detail-error {
  min-height: var(--df-touch-min);
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
}

.shared-meal-menu-pagination {
  display: flex;
  min-height: var(--df-touch-min);
  align-items: center;
  justify-content: center;
}

.shared-meal-menu-pagination-error {
  min-height: 96rpx;
}

.shared-meal-menu-pagination-error__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: var(--df-space-2);
}

.shared-meal-menu-pagination-error__title {
  color: var(--df-color-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.shared-meal-menu-pagination-error__description {
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 36rpx;
}

.shared-meal-menu-selection-summary {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 280rpx;
  box-sizing: border-box;
  flex-direction: column;
  gap: var(--df-space-3);
  padding: var(--df-space-4) var(--df-space-6);
  padding-bottom: calc(var(--df-space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--df-space-4) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--df-color-line);
  background: var(--df-color-surface);
}

.shared-meal-menu-selection-summary__title {
  height: 48rpx;
  color: var(--df-color-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.shared-meal-menu-selection-summary__tags,
.shared-meal-menu-selection-summary__hint {
  width: 100%;
  height: var(--df-touch-min);
}

.shared-meal-menu-selection-summary__tags {
  min-width: 0;
  white-space: nowrap;
}

.shared-meal-menu-selection-summary__tag {
  display: inline-block;
  margin-right: var(--df-space-3);
  vertical-align: top;
}

.shared-meal-menu-selection-summary__hint {
  display: flex;
  align-items: center;
  color: var(--df-color-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.shared-meal-menu-selection-summary__error {
  position: absolute;
  right: 0;
  bottom: calc(100% + var(--df-space-3));
  left: 0;
  padding: var(--df-space-3) var(--df-space-5);
  border-radius: var(--df-radius-lg);
  color: var(--df-color-warning);
  background: var(--df-color-warning-soft);
  font-size: var(--df-font-sm);
  line-height: 36rpx;
}

.shared-meal-menu-selection-summary__confirm {
  height: 88rpx;
  box-sizing: border-box;
}
