<view class="page onboarding-hero-page" aria-label="狗饭引导">
  <view class="onboarding-hero-media" aria-hidden="true">
    <image class="onboarding-hero-photo" src="{{onboardingHeroImage}}" mode="aspectFill" />
    <view class="onboarding-hero-fade"></view>
  </view>

  <view class="onboarding-hero-copy">
    <view class="onboarding-hero-title">
      <text>先认识它，</text>
      <text>再照顾好每一</text>
      <text>顿。</text>
    </view>
    <view class="onboarding-hero-description">建一份狗狗档案，让饮食记录、体重变化和日常状态都有据可循。</view>
    <view class="onboarding-hero-meta">
      <view class="onboarding-hero-meta__line" aria-hidden="true"></view>
      <text>4 步完成 · 约 1 分钟</text>
    </view>
    <view class="onboarding-hero-action">
      <ui-button variant="primary" size="xlarge" bind:tap="onStart" ariaLabel="开始建立档案">开始建立档案</ui-button>
      <view class="onboarding-hero-login">
        <ui-button
          variant="bare"
          block="{{false}}"
          disabled="{{loginLoading}}"
          bind:tap="onDirectLogin"
          ariaLabel="已有档案，直接登录"
        >
          <text class="onboarding-hero-login__prompt">已有档案？</text>
          <text class="onboarding-hero-login__action">{{loginLoading ? '登录中…' : '直接登录'}}</text>
        </ui-button>
      </view>
    </view>
  </view>
</view>
