<view class="nutrition-assessment">
  <view
    wx:if="{{!expanded}}"
    class="nutrition-assessment__summary"
    hover-class="nutrition-assessment__summary--pressed"
    bindtap="onToggle"
  >
    <view class="nutrition-assessment__handle"></view>
    <view class="nutrition-assessment__summary-head">
      <view class="nutrition-assessment__summary-heading">营养评估</view>
      <view class="nutrition-assessment__summary-link">查看详情 ›</view>
    </view>
    <block wx:if="{{loading}}">
      <view class="nutrition-assessment__summary-status">正在评估</view>
      <view class="nutrition-assessment__summary-advice">正在读取食材营养和参考标准</view>
    </block>
    <block wx:elif="{{viewAssessment}}">
      <view class="nutrition-assessment__summary-status nutrition-assessment__summary-status--{{viewAssessment.status}}">
        {{viewAssessment.statusLabel}}
      </view>
      <view class="nutrition-assessment__summary-advice">{{viewAssessment.primaryAdvice}}</view>
    </block>
  </view>

  <view wx:else class="nutrition-assessment__expanded">
    <scroll-view class="nutrition-assessment__scroll" scroll-y enable-flex>
      <view class="nutrition-assessment__expanded-content">
        <view class="nutrition-assessment__expanded-head">
          <view>
            <view class="nutrition-assessment__expanded-title">营养评估</view>
            <view wx:if="{{viewAssessment}}" class="nutrition-assessment__expanded-context">{{viewAssessment.contextText}}</view>
          </view>
          <view
            class="nutrition-assessment__collapse"
            hover-class="nutrition-assessment__collapse--pressed"
            bindtap="onToggle"
          >收起</view>
        </view>

        <view wx:if="{{loading}}" class="nutrition-assessment__loading">正在读取营养数据和参考标准</view>

        <block wx:elif="{{viewAssessment}}">
          <view class="nutrition-assessment__basis">{{viewAssessment.basisText}}</view>

          <view class="nutrition-assessment__conclusion">
            <view class="nutrition-assessment__conclusion-label">评估结论</view>
            <view class="nutrition-assessment__conclusion-status nutrition-assessment__conclusion-status--{{viewAssessment.status}}">
              {{viewAssessment.statusLabel}}
            </view>
            <view class="nutrition-assessment__conclusion-advice">{{viewAssessment.primaryAdvice}}</view>
            <view class="nutrition-assessment__conclusion-counts">
              {{viewAssessment.counts.adjust}} 项建议调整 · {{viewAssessment.counts.met}} 项处于参考范围 · {{viewAssessment.counts.unavailable}} 项无法评估
            </view>
          </view>

          <block wx:if="{{viewAssessment.available}}">
            <view wx:for="{{viewAssessment.standards}}" wx:key="key" class="nutrition-assessment__standard">
              <view class="nutrition-assessment__standard-head">
                <view class="nutrition-assessment__standard-title">{{item.key === 'gb' ? '国标评估' : 'FEDIAF 评估'}}</view>
                <view
                  class="nutrition-assessment__profile-link"
                  data-key="{{item.key}}"
                  bindtap="onOpenProfileSelector"
                >{{item.shortProfileName}} · 更改 ›</view>
              </view>
              <view class="nutrition-assessment__standard-source">{{item.code}} · {{item.profileSelection === 'manual' ? '已手动选择' : '根据狗狗档案自动选择'}}</view>

              <view wx:for="{{item.highItems}}" wx:for-item="nutrient" wx:key="code" class="nutrition-assessment__item nutrition-assessment__item--high">
                <view class="nutrition-assessment__item-title">需要控制 · {{nutrient.name}}</view>
                <view class="nutrition-assessment__item-value">当前 {{nutrient.currentText}} · 参考要求 {{nutrient.requirementText}}</view>
                <view class="nutrition-assessment__contributors">主要来源：{{nutrient.contributorsText || '暂无可靠来源数据'}}</view>
                <ui-button
                  variant="secondary"
                  size="small"
                  data-standard="{{item.key}}"
                  data-code="{{nutrient.code}}"
                  bind:tap="onHighAction"
                >{{nutrient.actionText}} ›</ui-button>
              </view>

              <view wx:for="{{item.lowItems}}" wx:for-item="nutrient" wx:key="code" class="nutrition-assessment__item nutrition-assessment__item--low">
                <view class="nutrition-assessment__item-title">需要补充 · {{nutrient.name}}</view>
                <view class="nutrition-assessment__item-value">当前 {{nutrient.currentText}} · 参考要求 {{nutrient.requirementText}}</view>
                <ui-button
                  variant="secondary"
                  size="small"
                  event-value="{{nutrient.code}}"
                  data-standard="{{item.key}}"
                  data-code="{{nutrient.code}}"
                  bind:tap="onLowAction"
                >{{nutrient.actionText}} ›</ui-button>
              </view>

              <view class="nutrition-assessment__met">✓ 处于参考范围 · {{item.metCount}} 项</view>
              <view wx:if="{{item.unavailableCount}}" class="nutrition-assessment__unavailable">{{item.unavailableCount}} 项因数据不足无法评估</view>
            </view>

            <view class="nutrition-assessment__elements-entry" bindtap="onToggleElements">
              <view>
                <view class="nutrition-assessment__elements-heading">全部元素对照</view>
                <view class="nutrition-assessment__elements-description">查看所有元素的含量、标准要求和满足情况</view>
              </view>
              <view class="nutrition-assessment__elements-arrow">{{elementsVisible ? '收起' : '展开'}} ›</view>
            </view>

            <view wx:if="{{elementsVisible}}" class="nutrition-assessment__elements">
              <view class="nutrition-assessment__filters">
                <view class="nutrition-assessment__filter {{elementFilter === 'all' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="all" bindtap="onElementFilter">全部</view>
                <view class="nutrition-assessment__filter {{elementFilter === 'adjust' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="adjust" bindtap="onElementFilter">需调整</view>
                <view class="nutrition-assessment__filter {{elementFilter === 'met' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="met" bindtap="onElementFilter">范围内</view>
                <view class="nutrition-assessment__filter {{elementFilter === 'unavailable' ? 'nutrition-assessment__filter--active' : ''}}" data-filter="unavailable" bindtap="onElementFilter">无法评估</view>
              </view>
              <scroll-view class="nutrition-assessment__table-scroll" scroll-x>
                <view class="nutrition-assessment__table">
                  <view class="nutrition-assessment__table-row nutrition-assessment__table-row--head">
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-cell--name">营养元素</view>
                    <view class="nutrition-assessment__table-cell">本餐含量</view>
                    <view class="nutrition-assessment__table-cell">国标要求</view>
                    <view class="nutrition-assessment__table-cell">FEDIAF 要求</view>
                  </view>
                  <view wx:for="{{filteredElements}}" wx:key="code" class="nutrition-assessment__table-row">
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-cell--name">{{item.name}}</view>
                    <view class="nutrition-assessment__table-cell">{{item.currentText}}</view>
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-status--{{item.gb.status}}">
                      <view>{{item.gb.requirementText}}</view>
                      <view>{{item.gbStatusLabel}}</view>
                    </view>
                    <view class="nutrition-assessment__table-cell nutrition-assessment__table-status--{{item.fediaf.status}}">
                      <view>{{item.fediaf.requirementText}}</view>
                      <view>{{item.fediafStatusLabel}}</view>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </view>
          </block>

          <view wx:else class="nutrition-assessment__missing">
            <view class="nutrition-assessment__missing-heading">影响评估的数据</view>
            <view wx:for="{{viewAssessment.missingIngredients}}" wx:key="id" class="nutrition-assessment__missing-item">
              {{item.name}}：{{item.reason}}
            </view>
            <view class="nutrition-assessment__missing-note">缺失值不会按 0 计算</view>
            <view class="nutrition-assessment__retry">
              <ui-button variant="secondary" size="small" bind:tap="onRetry">重新评估</ui-button>
            </view>
          </view>

          <view class="nutrition-assessment__disclaimer">
            营养评估用于配方参考，结果依据食材数据、狗狗档案和所选标准计算。如有健康问题或特殊营养需求，请咨询兽医或宠物营养专业人士。
          </view>
        </block>
      </view>
    </scroll-view>

    <view wx:if="{{profileSelectorVisible}}" class="nutrition-assessment__profile-mask" catchtap="onCloseProfileSelector">
      <view class="nutrition-assessment__profile-sheet" catchtap="onProfileSheetTap">
        <view class="nutrition-assessment__profile-title">{{profileSelectorTitle}}</view>
        <view class="nutrition-assessment__profile-description">系统会根据狗狗档案推荐，本次修改只影响当前食谱。</view>
        <view
          wx:for="{{profileOptions}}"
          wx:key="code"
          class="nutrition-assessment__profile-option {{pendingProfileCode === item.code ? 'nutrition-assessment__profile-option--active' : ''}}"
          data-code="{{item.code}}"
          bindtap="onSelectProfile"
        >
          <view class="nutrition-assessment__profile-radio"></view>
          <view>
            <view class="nutrition-assessment__profile-name">{{item.name}}</view>
            <view wx:if="{{item.recommended}}" class="nutrition-assessment__profile-recommended">系统推荐</view>
          </view>
        </view>
        <view class="nutrition-assessment__profile-actions">
          <ui-button variant="secondary" bind:tap="onCloseProfileSelector">取消</ui-button>
          <ui-button bind:tap="onApplyProfile">应用</ui-button>
        </view>
      </view>
    </view>
  </view>
</view>
