.search {
  display: block;
}

.search-input {
  width: 100%;
  min-height: 58rpx;
}

.select-block {
  margin-top: 20rpx;
  display: grid;
  gap: 16rpx;
}

.filter-label {
  display: block;
  color: var(--df-color-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.filter-value {
  display: block;
  margin-top: 4rpx;
  color: var(--df-color-text);
  font-size: 26rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-filter {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.filter-notice,
.recipe-link {
  margin-top: 20rpx;
}

.filter-notice {
  font-weight: 700;
}
