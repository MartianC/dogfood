<view class="page with-tab-bar home-page" aria-label="首页">
  <view class="home-header">
    <view class="home-header__date df-caption">{{todayText}}</view>
    <view class="home-header__title df-heading-xl">今天接下来做什么？</view>
    <view class="home-header__copy df-body">记录今天和狗狗共享的一顿饭，按这次的菜单单独称量。</view>
  </view>

  <ui-card
    variant="plain"
    padding="large"
  >
    <view class="home-primary home-primary--{{homeState.status}}">
      <view class="home-primary__eyebrow">当前主任务</view>
      <view class="home-primary__title">{{homeState.primaryTask.label}}</view>
      <view class="home-primary__description">{{homeState.primaryTask.description}}</view>
      <ui-button variant="primary" bind:tap="onPrimaryTask">{{homeState.primaryTask.label}}</ui-button>
    </view>
  </ui-card>

  <ui-notice
    wx:if="{{homeState.status === 'data-error'}}"
    variant="warning"
  >
    <view class="home-error">
      <view class="home-error__title">{{homeState.error.title}}</view>
      <view class="home-error__description">{{homeState.error.description}}</view>
      <ui-button variant="secondary" size="small" bind:tap="onRetryHome">重新加载</ui-button>
    </view>
  </ui-notice>

  <view class="home-section">
    <view class="home-section__head">
      <view class="df-heading-lg">今天</view>
    </view>
    <ui-card padding="medium">
      <view class="home-summary">
        <view class="home-summary__title">{{homeState.todaySummary.title}}</view>
        <view class="home-summary__description">{{homeState.todaySummary.description}}</view>
        <view wx:if="{{homeState.todaySummary.count}}" class="home-summary__dogs">
          <text wx:for="{{homeState.todaySummary.dogNames}}" wx:key="*this" class="home-summary__dog">{{item}}</text>
        </view>
      </view>
    </ui-card>
  </view>

  <view wx:if="{{homeState.draft}}" class="home-section">
    <view class="home-section__head">
      <view class="df-heading-lg">正在继续</view>
    </view>
    <ui-card variant="soft" padding="medium">
      <view class="home-draft">
        <view class="home-draft__title">{{homeState.draft.dogName}} · {{homeState.draft.menuText}}</view>
        <view class="home-draft__meta">{{homeState.draft.updatedAtText}} · 由你决定继续或重新开始</view>
      </view>
    </ui-card>
  </view>

  <view wx:if="{{homeState.profileIssues.length}}" class="home-section">
    <view class="home-section__head">
      <view class="df-heading-lg">狗狗事项</view>
      <view class="home-section__hint">最多显示 3 条</view>
    </view>
    <view class="home-issue-list">
      <ui-card
        wx:for="{{homeState.profileIssues}}"
        wx:key="key"
        padding="small"
      >
        <view
          class="home-issue"
          data-dog-id="{{item.dogId}}"
          data-action="{{item.action}}"
          aria-role="button"
          aria-label="{{item.dogName}}，{{item.title}}"
          bind:tap="onOpenProfileIssue"
        >
          <view class="home-issue__copy">
            <view class="home-issue__title">{{item.dogName}} · {{item.title}}</view>
            <view class="home-issue__description">{{item.description}}</view>
          </view>
          <view class="home-issue__chevron" aria-hidden="true">›</view>
        </view>
      </ui-card>
    </view>
  </view>

  <view class="home-section home-recent">
    <view class="home-section__head">
      <view class="df-heading-lg">最近一顿</view>
      <view
        wx:if="{{homeState.status !== 'guest'}}"
        class="home-section__action"
        aria-role="button"
        aria-label="查看全部本餐记录"
        bind:tap="onOpenRecords"
      >全部记录</view>
    </view>
    <ui-card wx:if="{{homeState.recentRecord}}" padding="medium">
      <view
        class="home-record"
        aria-role="button"
        aria-label="查看{{homeState.recentRecord.dogName}}的最近一顿记录"
        bind:tap="onOpenLatestRecord"
      >
        <view class="home-record__copy">
          <view class="home-record__title">{{homeState.recentRecord.dogName}} · {{homeState.recentRecord.menuText}}</view>
          <view class="home-record__meta">{{homeState.recentRecord.ingredientCount}} 种狗饭食材 · {{homeState.recentRecord.snapshotText}}</view>
        </view>
        <view class="home-record__chevron" aria-hidden="true">›</view>
      </view>
    </ui-card>
    <ui-empty
      wx:else
      title="{{homeState.status === 'guest' ? '登录后查看最近记录' : homeState.recentSummary.title}}"
      description="{{homeState.status === 'guest' ? '登录后可以查看真实的本餐快照。' : homeState.recentSummary.description}}"
    />
  </view>
</view>
