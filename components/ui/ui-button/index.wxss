@import "../../../styles/tokens.wxss";

:host {
  display: block;
}

.ui-button {
  min-height: var(--df-touch-min);
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--df-radius-lg);
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--df-color-text-secondary);
  background: var(--df-color-surface);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.ui-button::after {
  border: 0;
}

.ui-button--block {
  width: 100%;
}

.ui-button--inline {
  width: auto;
  display: inline-flex;
}

.ui-button--medium {
  min-height: 80rpx;
  font-size: 28rpx;
}

.ui-button--small {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.ui-button--avatar {
  width: 96rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 24rpx;
  color: var(--df-color-text);
  background: var(--df-color-surface-muted);
  border-color: var(--df-color-line-strong);
}

.ui-button--xlarge {
  min-height: max(96rpx, 48px);
  border-radius: max(var(--df-radius-lg), 12px);
  font-size: max(30rpx, 15px);
}

.ui-button--primary {
  color: var(--df-color-on-primary);
  background: var(--df-color-primary);
  border-color: var(--df-color-primary);
}

.ui-button--secondary {
  color: var(--df-color-text-secondary);
  background: var(--df-color-surface);
  border-color: var(--df-color-line-strong);
}

.ui-button--outline {
  color: var(--df-color-primary);
  background: var(--df-color-surface);
  border-color: var(--df-color-primary);
}

.ui-button--warning {
  color: var(--df-color-on-primary);
  background: var(--df-color-warning);
  border-color: var(--df-color-warning);
}

.ui-button--warning-outline {
  color: var(--df-color-warning);
  background: var(--df-color-surface);
  border-color: var(--df-color-warning);
  border-width: 1px;
}

.ui-button--ghost {
  color: var(--df-color-primary);
  background: var(--df-color-primary-soft);
  border-color: transparent;
}

.ui-button--pressed.ui-button--primary {
  background: var(--df-color-primary-pressed);
  border-color: var(--df-color-primary-pressed);
}

.ui-button--pressed.ui-button--secondary {
  background: var(--df-color-surface-pressed);
  border-color: var(--df-color-line-strong);
}

.ui-button--pressed.ui-button--outline {
  background: var(--df-color-primary-soft);
  border-color: var(--df-color-primary-pressed);
}

.ui-button--pressed.ui-button--warning {
  background: var(--df-color-warning-pressed);
  border-color: var(--df-color-warning-pressed);
}

.ui-button--pressed.ui-button--warning-outline {
  color: var(--df-color-warning-pressed);
  background: var(--df-color-warning-soft);
  border-color: var(--df-color-warning-pressed);
}

.ui-button--pressed.ui-button--ghost {
  background: var(--df-color-primary-soft-pressed);
}

.ui-button[disabled] {
  opacity: 0.56;
}

.ui-button--avatar[disabled] {
  opacity: 1;
}
