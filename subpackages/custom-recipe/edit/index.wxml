<view class="page recipe-design-page {{ingredients.length ? 'recipe-design-page--editing' : ''}}">
  <view class="recipe-design-header">
    <view class="recipe-design-dog">{{targetDogName || '未选择狗狗'}}</view>
    <view class="recipe-design-heading df-heading-xl">{{title}}</view>
  </view>

  <block wx:if="{{!ingredients.length}}">
    <view class="recipe-design-empty">
      <recipe-empty
        icon="search"
        title="还没有添加食材"
        description="搜索食材并填写克重后，本餐评估会自动更新。"
        action-text="新增食材"
        bind:action="onAddIngredient"
      />
    </view>
  </block>

  <block wx:else>
    <view class="recipe-design-editing-content">
      <scroll-view class="recipe-design-ingredient-scroll" scroll-y enable-flex>
        <view class="recipe-design-ingredient-scroll__content">
          <recipe-ingredient-list
            items="{{ingredientRows}}"
            mode="edit"
            action-icon="/assets/icons/recipe-delete-1-filled.svg"
            bind:amountchange="onIngredientAmountChange"
            bind:remove="onRemoveIngredient"
          />
          <view class="recipe-design-add-action">
            <ui-button variant="ghost" bind:tap="onAddIngredient">添加食材</ui-button>
          </view>
        </view>
      </scroll-view>

      <view class="recipe-design-summary-floating {{nutritionExpanded ? 'recipe-design-summary-floating--expanded' : ''}}">
        <nutrition-assessment
          assessment="{{mealAssessment}}"
          loading="{{nutritionLoading}}"
          expanded="{{nutritionExpanded}}"
          bind:toggle="onNutritionToggle"
          bind:profilechange="onNutritionProfileChange"
          bind:nutrientselect="onNutritionNutrientSelect"
          bind:adjustingredients="onNutritionAdjustIngredients"
          bind:scaleconfirm="onMealScaleConfirm"
          bind:completeprofile="onCompleteDogProfile"
          bind:retry="onNutritionRetry"
        />
      </view>
    </view>

    <view class="bottom-action recipe-design-save-action">
      <ui-button bind:tap="onSaveRecipe">保存食谱</ui-button>
    </view>
  </block>

</view>
