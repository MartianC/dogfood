.plan-hero {
  color: var(--df-color-on-primary);
}

.plan-eyebrow {
  color: var(--df-color-on-primary-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.plan-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 800;
}

.plan-subtitle {
  margin-top: 12rpx;
  color: var(--df-color-on-primary-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--df-color-surface-muted);
  line-height: 1.45;
}

.summary-row:last-child {
  border-bottom: 0;
}

.step-row {
  justify-content: flex-start;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 14rpx;
  background: var(--df-color-primary-soft);
  color: var(--df-color-primary);
  text-align: center;
  line-height: 44rpx;
  font-weight: 800;
}

.share-canvas {
  width: 320px;
  height: 420px;
  position: fixed;
  left: -9999px;
  top: -9999px;
}
