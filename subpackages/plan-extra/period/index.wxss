.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--df-color-surface-muted);
  line-height: 1.45;
}

.preview-row:last-child {
  border-bottom: 0;
}
