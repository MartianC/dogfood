@import "../../../styles/tokens.wxss";

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.profile-title {
  color: var(--df-color-text);
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.profile-meta {
  margin-top: 8rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}
