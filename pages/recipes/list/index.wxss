page {
  background: var(--df-color-surface);
}

.recipe-library-page {
  min-height: 100vh;
  padding-top: var(--df-space-4);
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
  background: var(--df-color-surface);
}

.recipe-library-intro {
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 1.5;
}

.recipe-library-list {
  display: grid;
  gap: var(--df-space-4);
  margin-top: var(--df-space-2);
}

.recipe-library-empty {
  display: flex;
  min-height: 720rpx;
  align-items: center;
  justify-content: center;
}

.recipe-library-fab {
  display: block;
}
