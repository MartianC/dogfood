<view class="page recipe-design-page">
  <block wx:if="{{!ingredients.length}}">
    <view class="recipe-design-empty">
      <recipe-empty
        icon="search"
        title="还没有添加食材"
        description="搜索食材并填写克重后，营养汇总会自动更新。"
        action-text="新增食材"
        bind:action="onAddIngredient"
      />
    </view>
    <view class="recipe-design-summary">
      <ui-card variant="soft" padding="small">
        <view class="recipe-design-summary__content">
          <view>
            <view class="recipe-design-summary__heading">营养汇总</view>
            <view class="recipe-design-summary__description">添加食材后显示营养汇总</view>
          </view>
          <view class="recipe-design-summary__weight">0 g</view>
        </view>
      </ui-card>
    </view>
  </block>

  <block wx:else>
    <ui-card>
      <view class="recipe-design-eyebrow df-caption">正在编辑</view>
      <view class="recipe-design-heading df-heading-xl">{{title}}</view>
      <view class="recipe-design-description df-body">填写每餐参考量，保存后可继续检查适配建议。</view>
    </ui-card>

    <view class="section">
      <ui-card>
        <ui-field label="食谱名称">
          <input class="recipe-design-control" value="{{title}}" bindinput="onTitle" placeholder="例如 家里简单饭" />
        </ui-field>
      </ui-card>
    </view>

    <view class="section">
      <ingredient-editor ingredients="{{ingredients}}" bind:change="onIngredients" />
    </view>

    <view class="section">
      <dog-target-selector dogs="{{dogs}}" selectedDogIds="{{selectedDogIds}}" bind:change="onTargetChange" />
    </view>

    <view class="section recipe-design-actions">
      <ui-button bind:tap="onCheckAdvice">检查并生成建议</ui-button>
      <ui-button variant="secondary" bind:tap="onSaveDraft">保存草稿</ui-button>
    </view>
  </block>
</view>
