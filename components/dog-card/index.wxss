@import "../../styles/tokens.wxss";

.dog-card-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: var(--df-color-on-primary);
}

.dog-avatar {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border: 2rpx solid var(--df-color-on-primary-muted);
  border-radius: 30rpx;
  background: var(--df-color-surface-muted);
  display: block;
}

.dog-body {
  min-width: 0;
  flex: 1;
}

.dog-name {
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 800;
}

.dog-meta,
.dog-goal {
  margin-top: 8rpx;
  color: var(--df-color-on-primary-muted);
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
