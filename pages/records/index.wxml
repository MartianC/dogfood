<view class="page with-tab-bar records-page" aria-label="记录">
  <view class="records-calendar-shell">
    <record-calendar
      value="{{selectedDateKey}}"
      calendarDays="{{calendarDays}}"
      loading="{{loading}}"
      bind:select="onCalendarSelect"
      bind:panelchange="onCalendarPanelChange"
    />
  </view>

  <view wx:if="{{loadStatus !== 'idle'}}" class="records-content">
    <view wx:if="{{loadStatus === 'loading' && !hasModel}}" class="records-state">
      <view class="records-state__heading">正在读取 {{activeMonthText}}记录</view>
      <view class="records-state__description">正在准备吃饭、体重和护理记录</view>
    </view>

    <view wx:elif="{{hasBlockingError}}" class="records-state">
      <ui-notice variant="warning">{{errorText}}</ui-notice>
      <view class="records-state__action">
        <ui-button size="small" block="{{false}}" bind:tap="onRetryTimeline">重新加载</ui-button>
      </view>
    </view>

    <block wx:else>
      <ui-notice wx:if="{{loadStatus === 'loading' && hasModel}}" class="records-refresh-notice">
        正在更新当前月份记录
      </ui-notice>

      <ui-empty
        wx:if="{{dogCount === 0 && !dogsLoadError}}"
        title="先添加狗狗档案"
        description="添加狗狗后，记录会按日期集中展示。"
        actionText="添加狗狗"
        bind:action="onAddDog"
      />

      <ui-empty
        wx:elif="{{!monthHasRecords}}"
        title="这个月还没有记录"
        description="保存第一顿后，日历会显示每天的记录。"
      />
      <view wx:if="{{!monthHasRecords}}" class="records-empty-action">
        <ui-button bind:tap="onCreateMeal">记录第一顿</ui-button>
      </view>

      <block wx:else>
        <view class="records-day-heading">
          <view class="records-day-heading__title">{{selectedDateHeading}}</view>
        </view>

        <ui-notice wx:if="{{hasPartialFailure}}" variant="warning" class="records-source-notice">
          <view>{{sourceNoticeText}}</view>
          <view class="records-source-notice__action">
            <ui-button size="small" block="{{false}}" variant="ghost" bind:tap="onRetryTimeline">重新加载</ui-button>
          </view>
        </ui-notice>

        <view wx:if="{{!isSingleDog}}" class="records-dog-groups">
          <view wx:for="{{dogGroups}}" wx:key="dogId" class="records-dog-group">
            <view
              class="records-dog-group__header"
              data-dog-id="{{item.dogId}}"
              aria-role="button"
              aria-label="{{item.dogName}}，{{item.toggleText}}"
              bindtap="onToggleDog"
            >
              <view class="records-dog-group__identity">
                <view class="records-dog-group__name">{{item.dogName}}</view>
                <view class="records-dog-group__count">{{item.recordCountText}}</view>
              </view>
              <view class="records-dog-group__toggle">{{item.toggleText}}</view>
            </view>

            <view wx:if="{{item.expanded && item.records.length}}" class="records-dog-group__records">
              <ui-card wx:for="{{item.records}}" wx:for-item="record" wx:key="id" padding="medium">
                <view
                  class="records-entry"
                  data-source="{{record.source}}"
                  data-source-id="{{record.sourceId}}"
                  data-dog-id="{{record.dogId}}"
                  aria-role="button"
                  aria-label="查看{{record.title}}"
                  bindtap="onOpenRecord"
                >
                  <view class="records-entry__content">
                    <view class="records-entry__meta">
                      <ui-tag variant="{{record.tagVariant}}" size="small">{{record.sourceLabel}}</ui-tag>
                    </view>
                    <view class="records-entry__heading">{{record.title}}</view>
                    <view class="records-entry__summary">{{record.summary}}</view>
                  </view>
                  <view class="records-entry__chevron" aria-hidden="true">›</view>
                </view>
              </ui-card>
            </view>
          </view>
        </view>

        <view wx:if="{{isSingleDog && selectedRecords.length}}" class="records-list">
          <ui-card wx:for="{{selectedRecords}}" wx:key="id" padding="medium">
            <view
              class="records-entry"
              data-source="{{item.source}}"
              data-source-id="{{item.sourceId}}"
              data-dog-id="{{item.dogId}}"
              aria-role="button"
              aria-label="查看{{item.title}}"
              bindtap="onOpenRecord"
            >
              <view class="records-entry__content">
                <view class="records-entry__meta">
                  <ui-tag variant="{{item.tagVariant}}" size="small">{{item.sourceLabel}}</ui-tag>
                </view>
                <view class="records-entry__heading">{{item.title}}</view>
                <view class="records-entry__summary">{{item.summary}}</view>
              </view>
              <view class="records-entry__chevron" aria-hidden="true">›</view>
            </view>
          </ui-card>
        </view>

      </block>
    </block>
  </view>
</view>
