@import "../../styles/tokens.wxss";

.editor {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ingredient-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 156rpx 156rpx 96rpx;
  gap: 12rpx;
  align-items: stretch;
}

.editor-control,
.picker-value {
  min-height: 58rpx;
  line-height: 58rpx;
  font-size: 26rpx;
}

.amount-control {
  text-align: right;
}

.remove-action {
  display: flex;
  align-items: center;
}
