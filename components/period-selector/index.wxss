@import "../../styles/tokens.wxss";

.period {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.option {
  height: 78rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: 18rpx;
  background: var(--df-color-surface);
  color: var(--df-color-text-secondary);
  line-height: 78rpx;
  text-align: center;
  font-weight: 700;
}

.option.active {
  border-color: var(--df-color-line-strong);
  background: var(--df-color-primary-soft);
  color: var(--df-color-primary);
}

.custom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--df-color-surface);
  border: 1rpx solid var(--df-color-line);
}

.custom-input {
  flex: 1;
  min-height: 58rpx;
  text-align: center;
  font-weight: 800;
}
