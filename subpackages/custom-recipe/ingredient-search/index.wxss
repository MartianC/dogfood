@import "../../../styles/tokens.wxss";

page {
  background: var(--df-color-surface);
}

.ingredient-search-page {
  min-height: 100vh;
  padding: 36rpx 32rpx 48rpx;
  background: var(--df-color-surface);
}

.ingredient-search-gap-summary {
  box-sizing: border-box;
  display: flex;
  min-height: 144rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin-bottom: var(--df-space-5);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--df-color-line);
  border-radius: var(--df-radius-xl);
  background: var(--df-color-bg);
}

.ingredient-search-gap-summary__value {
  color: var(--df-color-status-low);
  font-size: var(--df-font-lg);
  font-weight: 700;
  line-height: 48rpx;
}

.ingredient-search-gap-summary__basis {
  color: var(--df-color-muted);
  font-size: var(--df-font-xs);
  line-height: 32rpx;
}

.ingredient-search-state {
  margin-top: 48rpx;
}

.ingredient-search-heading {
  color: var(--df-color-text);
  font-size: var(--df-font-md);
  font-weight: 700;
  line-height: 38rpx;
}

.ingredient-search-heading--results {
  margin-bottom: 14rpx;
}

.ingredient-search-nutrient-note {
  margin-top: var(--df-space-5);
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 30rpx;
}

.ingredient-search-quick-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.ingredient-search-quick-list {
  display: inline-flex;
  align-items: center;
  gap: var(--df-space-3);
}

.ingredient-search-quick-option {
  display: inline-flex;
  flex: 0 0 auto;
}

.ingredient-search-quick-empty,
.ingredient-search-loading {
  padding: 40rpx 0;
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  text-align: center;
}

.ingredient-search-no-result {
  box-sizing: border-box;
  min-height: 136rpx;
  padding: 24rpx;
  border-radius: var(--df-radius-xl);
  background: var(--df-color-status-low-soft);
}

.ingredient-search-no-result__heading {
  color: var(--df-color-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.ingredient-search-no-result__description {
  margin-top: 14rpx;
  color: var(--df-color-muted);
  font-size: var(--df-font-sm);
  line-height: 32rpx;
}
