<t-checkbox
  wx:if="{{kind === 'checkbox'}}"
  t-class="recipe-menu-indicator__checkbox"
  checked="{{checked}}"
  disabled="{{disabled}}"
  icon="circle"
  block="{{false}}"
  borderless
  bind:change="onCheckboxChange"
/>

<view
  wx:elif="{{kind === 'icon'}}"
  class="recipe-menu-indicator recipe-menu-indicator--icon recipe-menu-indicator--{{tone}}"
  style="width: {{iconSize}}; height: {{iconSize}};"
  aria-hidden="true"
>
  <t-icon
    t-class="recipe-menu-indicator__icon"
    name="{{icon}}"
    size="{{iconSize}}"
  />
</view>

<view wx:else class="recipe-menu-indicator recipe-menu-indicator--loading recipe-menu-indicator--{{kind}}">
  <t-loading
    t-class="recipe-menu-indicator__loading"
    theme="circular"
    size="{{iconSize}}"
    text="{{text}}"
  />
</view>
