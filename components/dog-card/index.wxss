.dog-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #25684a;
  color: #ffffff;
}

.name {
  font-size: 34rpx;
  font-weight: 800;
}

.meta,
.goal {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.edit {
  width: 116rpx;
  height: 60rpx;
  border-radius: 999rpx;
  color: #25684a;
  background: #ffffff;
  font-size: 24rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.edit::after {
  border: 0;
}
