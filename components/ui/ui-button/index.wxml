<button
  class="ui-button ui-button--{{variant}} ui-button--{{size}} {{block ? 'ui-button--block' : 'ui-button--inline'}}"
  disabled="{{disabled || loading}}"
  loading="{{loading}}"
  open-type="{{openType}}"
  aria-label="{{ariaLabel}}"
  hover-class="ui-button--pressed"
  bindtap="handleTap"
  bindchooseavatar="handleChooseAvatar"
>
  <slot />
</button>
