<view class="recipe-card" bindtap="onTap">
  <ui-card padding="none">
    <view class="recipe-card__inner">
      <view class="recipe-card__thumb">
        <image class="recipe-card__thumb-image" src="{{recipe.imageUrl || defaultRecipeImage}}" mode="aspectFill" />
      </view>
      <view class="recipe-card__body">
        <view class="recipe-card__title-row">
          <view class="recipe-card__name">{{recipe.title}}</view>
        </view>
        <view class="recipe-card__desc">{{recipe.description}}</view>
        <view class="recipe-card__ingredients">主食材：{{recipe.mainIngredientText}}</view>
        <view class="recipe-card__meta">
          <ui-tag wx:if="{{showFit && recipe.fit && recipe.fit.label}}" size="small" variant="{{recipe.fit.status === 'ok' ? 'good' : (recipe.fit.status === 'warning' || recipe.fit.status === 'danger' ? 'warning' : 'neutral')}}">{{recipe.fit.label}}</ui-tag>
          <ui-tag wx:for="{{recipe.tags}}" wx:key="*this" size="small" variant="{{index === 0 ? 'good' : 'neutral'}}">{{item}}</ui-tag>
          <ui-tag size="small">{{recipe.cookingTimeMinutes}} 分钟</ui-tag>
        </view>
      </view>
    </view>
  </ui-card>
</view>
