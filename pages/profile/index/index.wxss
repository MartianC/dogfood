@import "../../../styles/tokens.wxss";

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--df-color-line-strong);
  background: var(--df-color-surface-muted);
  display: block;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.profile-title {
  color: var(--df-color-text);
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.profile-meta {
  margin-top: 8rpx;
  color: var(--df-color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.panel-action {
  margin-top: 24rpx;
}

.panel-title {
  color: var(--df-color-text);
  font-size: 32rpx;
  font-weight: 800;
}

.panel-desc {
  margin-top: 12rpx;
  color: var(--df-color-muted);
  font-size: 25rpx;
  line-height: 1.5;
}

.section-action {
  color: var(--df-color-primary);
  font-size: 26rpx;
}

.profile-dog-list,
.menu {
  display: grid;
  gap: 16rpx;
}

.dog-panel {
  display: grid;
  grid-template-columns: 88rpx 1fr;
  gap: 20rpx;
  align-items: center;
}

.dog-avatar {
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid var(--df-color-line-strong);
  border-radius: 24rpx;
  background: var(--df-color-surface-muted);
  display: block;
}

.dog-copy {
  min-width: 0;
}

.dog-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--df-color-text);
  font-size: 28rpx;
  font-weight: 800;
}

.edit-link {
  color: var(--df-color-primary);
  font-size: 26rpx;
}

.dog-meta {
  margin-top: 10rpx;
  color: var(--df-color-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.menu {
  margin-top: 32rpx;
}

.menu-item {
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--df-color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.chevron {
  color: var(--df-color-muted);
  font-size: 34rpx;
}
