<view class="page ingredient-search-page">
  <view wx:if="{{isNutrientMode}}" class="ingredient-search-gap-summary">
    <view class="ingredient-search-gap-summary__value">{{nutrientGapText}}</view>
    <view class="ingredient-search-gap-summary__basis">{{nutrientBasisText}}</view>
  </view>

  <recipe-ingredient-search
    value="{{searchValue}}"
    loading="{{searchLoading}}"
    action-text="取消"
    bind:change="onSearchChange"
    bind:action="onSearchAction"
  />

  <view class="ingredient-search-state">
    <block wx:if="{{isNutrientMode}}">
      <view wx:if="{{searchLoading}}" class="ingredient-search-loading">正在读取营养数据</view>

      <view wx:elif="{{searchError}}" class="ingredient-search-no-result" bindtap="onRetrySearch">
        <view class="ingredient-search-no-result__heading">营养数据加载失败</view>
        <view class="ingredient-search-no-result__description">请稍后重试，点此重新加载</view>
      </view>

      <block wx:elif="{{searchResults.length}}">
        <view class="ingredient-search-heading ingredient-search-heading--results">
          按{{nutrientName}}含量排序 · {{searchResults.length}} 种
        </view>
        <recipe-ingredient-list
          items="{{searchResults}}"
          mode="search"
          action-icon="/assets/icons/recipe-cart-filled.svg"
          bind:select="onSelectIngredient"
        />
        <view class="ingredient-search-nutrient-note">点击食材后填写克重；仅展示有可靠营养数据的结果</view>
      </block>

      <view wx:else class="ingredient-search-no-result">
        <block wx:if="{{hasSearchQuery}}">
          <view class="ingredient-search-no-result__heading">没有找到“{{searchValue}}”</view>
          <view class="ingredient-search-no-result__description">试试更短的关键词，或检查名称是否正确</view>
        </block>
        <block wx:else>
          <view class="ingredient-search-no-result__heading">暂无可靠营养数据</view>
          <view class="ingredient-search-no-result__description">当前没有可用于排序的食材记录</view>
        </block>
      </view>
    </block>

    <block wx:if="{{!isNutrientMode}}">
      <block wx:if="{{!hasSearchQuery}}">
        <view class="ingredient-search-heading">常用与最近</view>
        <scroll-view class="ingredient-search-quick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="ingredient-search-quick-list">
            <view
              wx:for="{{quickIngredients}}"
              wx:key="id"
              class="ingredient-search-quick-option"
              data-index="{{index}}"
              bindtap="onQuickIngredientTap"
              aria-role="button"
              aria-label="添加{{item.name}}"
            >
              <ui-tag variant="good" size="large">{{item.name}}</ui-tag>
            </view>
          </view>
        </scroll-view>
        <view
          wx:if="{{!catalogLoading && !quickIngredients.length}}"
          class="ingredient-search-quick-empty"
        >暂无常用食材</view>

        <view class="ingredient-search-catalog">
          <view class="ingredient-search-heading ingredient-search-heading--results">
            食材列表{{catalogIngredients.length ? ' · 已加载 ' + catalogIngredients.length + ' 种' : ''}}
          </view>
          <view wx:if="{{catalogLoading}}" class="ingredient-search-loading">正在读取食材列表</view>
          <view wx:elif="{{catalogError}}" class="ingredient-search-no-result" bindtap="onRetryCatalog">
            <view class="ingredient-search-no-result__heading">食材列表加载失败</view>
            <view class="ingredient-search-no-result__description">请稍后重试，点此重新加载</view>
          </view>
          <recipe-ingredient-list
            wx:elif="{{catalogIngredients.length}}"
            items="{{catalogIngredients}}"
            mode="search"
            action-icon="/assets/icons/recipe-cart-filled.svg"
            bind:select="onSelectIngredient"
          />
          <view wx:else class="ingredient-search-quick-empty">暂无可添加的食材</view>
          <view wx:if="{{catalogLoadingMore}}" class="ingredient-search-loading">正在加载更多</view>
          <view
            wx:elif="{{catalogLoadMoreError}}"
            class="ingredient-search-loading"
            bindtap="onRetryCatalogMore"
            aria-role="button"
            aria-label="重新加载更多食材"
          >加载失败，点此重试</view>
        </view>
      </block>

      <view wx:elif="{{searchLoading}}" class="ingredient-search-loading">正在搜索</view>

      <view wx:elif="{{searchError}}" class="ingredient-search-no-result" bindtap="onRetrySearch">
        <view class="ingredient-search-no-result__heading">搜索失败</view>
        <view class="ingredient-search-no-result__description">请稍后重试，点此重新搜索</view>
      </view>

      <block wx:elif="{{searchResults.length}}">
        <view class="ingredient-search-heading ingredient-search-heading--results">
          搜索结果 · 已加载 {{searchResults.length}} 种
        </view>
        <recipe-ingredient-list
          items="{{searchResults}}"
          mode="search"
          action-icon="/assets/icons/recipe-cart-filled.svg"
          bind:select="onSelectIngredient"
        />
        <view wx:if="{{searchLoadingMore}}" class="ingredient-search-loading">正在加载更多</view>
        <view
          wx:elif="{{searchLoadMoreError}}"
          class="ingredient-search-loading"
          bindtap="onRetrySearchMore"
          aria-role="button"
          aria-label="重新加载更多搜索结果"
        >加载失败，点此重试</view>
      </block>

      <view wx:else class="ingredient-search-no-result">
        <view class="ingredient-search-no-result__heading">没有找到“{{searchValue}}”</view>
        <view class="ingredient-search-no-result__description">试试更短的关键词，或检查名称是否正确</view>
      </view>
    </block>
  </view>

  <recipe-ingredient-popup
    visible="{{popupVisible}}"
    ingredient="{{selectedIngredient}}"
    bind:visiblechange="onPopupVisibleChange"
    bind:cancel="onPopupCancel"
    bind:confirm="onPopupConfirm"
  />
</view>
